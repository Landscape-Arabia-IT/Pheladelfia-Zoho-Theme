{% if recommended_products.products | size > 0 %}
<div class="ph-rec">
  <p class="ph-kicker">Recommended</p>
  <h2 class="ph-h3">You may also like</h2>
  <div class="ph-product-grid">
    {% for product in recommended_products.products %}
      {% include "store-product-list" %}
    {% endfor %}
  </div>
</div>
{% endif %}
