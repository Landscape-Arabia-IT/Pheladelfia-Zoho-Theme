{% extends "_theme" %}
{% block content %}
<div class="phx-shell phx-checkout">
{% include "_purchase-header" %}
<section class="phx-main">
  <header class="phx-title"><div><p class="phx-eyebrow">PHELADELFIA / CHECKOUT</p><h1>Complete your order.</h1><p>One step closer to your green space.</p></div><a class="phx-back" href="/cart">Edit cart <span aria-hidden="true">↗</span></a></header>
  <div class="phx-flow">{{ checkout.form }}</div>
</section>
{% include "_purchase-footer" %}
</div>
{% endblock %}
