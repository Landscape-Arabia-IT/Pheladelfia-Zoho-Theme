{% extends "_theme" %}
{% block content %}
<section class="ph-store ph-product-page">
  <div class="ph-wrap">
    <nav class="ph-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {% for crumb in product.bread_crumbs %}
      <span class="ph-crumb-sep">/</span>
      {% if crumb.is_selected %}
      <span>{{ crumb.name }}</span>
      {% else %}
      <a href="{{ crumb.url }}">{{ crumb.name }}</a>
      {% endif %}
      {% endfor %}
    </nav>
    <div class="ph-product-detail">
      <div class="ph-gallery-col">
        <div class="ph-product-gallery" data-ph-gallery data-ph-product-gallery>
          <div class="ph-main-image" data-ph-main-image>{% include "_store-product-image" %}</div>
          <div class="ph-thumbs" data-ph-thumbs></div>
        </div>
      </div>
      <div class="ph-product-buy">
        {% if product.category_name %}<p class="ph-kicker">{{ product.category_name }}</p>{% endif %}
        <h1 class="ph-h2">{{ product.name }}</h1>
        <div class="ph-price-row">
          <div class="ph-price" data-ph-price data-zs-selling-price="{{ product.selling_price }}"{% if product.has_variant_price %} data-ph-price-min="{{ product.starts_with }}" data-ph-price-max="{{ product.ends_with }}"{% endif %}>
            {% if product.has_variant_price %}{{ currency.symbol }}{{ product.starts_with }} – {{ currency.symbol }}{{ product.ends_with }}{% else %}{{ currency.symbol }}{{ product.selling_price }}{% endif %}
          </div>
          <p class="ph-price-note">{{ ph_vat_note }}{% if product.unit %} · Sold as {{ product.unit }}{% endif %}</p>
        </div>
        {% if product.is_product_review_enabled %}
        <div class="ph-rating" data-zs-review-id="{{ product.review_id }}" data-zs-review-type="average-rating"></div>
        <div class="ph-rating-stars" data-zs-review-id="{{ product.review_id }}" data-zs-review-type="star-rating"></div>
        {% endif %}
        <div class="ph-product-meta">
          <span data-ph-sku></span>
          <span class="ph-stock" data-ph-stock hidden></span>
        </div>
        {% if product.short_description %}<div class="ph-lead">{{ product.short_description }}</div>{% endif %}
        {% include "_store-product-variants" %}
        <div class="ph-buy">
          <div class="ph-buy-row">
            <div class="ph-qty-box">
              <button type="button" class="ph-qty-btn" data-ph-qty-minus aria-label="Decrease quantity">−</button>
              <input class="ph-qty" data-zs-quantity type="number" min="1" value="1" aria-label="Quantity">
              <button type="button" class="ph-qty-btn" data-ph-qty-plus aria-label="Increase quantity">+</button>
            </div>
            <button class="ph-btn" type="button" data-zs-add-to-cart data-zs-product-id="{{ product.product_id }}">Add to selection</button>
          </div>
          <p class="ph-buy-error" data-theme-error style="display:none;"></p>
          <p class="ph-buy-ok" data-ph-buy-ok hidden></p>
          {% if page.is_portal_enabled %}
          <p class="ph-actions"><button class="ph-wish-toggle" type="button" data-zs-wishlist-element data-ph-auth-wishlist{% if product.variants %}{% for variant in product.variants %}{% if forloop.first %} data-zs-wishlist-variant-id="{{ variant.variant_id }}"{% endif %}{% endfor %}{% endif %} hidden aria-pressed="false"><svg class="ph-wish-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><span class="ph-wish-label">Save to wishlist</span></button></p>
          {% endif %}
        </div>
        <div class="ph-share" data-ph-share data-share-url="https://{{ page.primary_domain }}{{ product.url }}" data-share-text="{{ product.name }}">
          <span class="ph-share-label">Share</span>
          <a class="ph-share-link" href="#" data-ph-share-net="whatsapp" aria-label="Share on WhatsApp"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.83 14.12c-.24.68-1.42 1.3-1.96 1.35-.5.05-1.13.24-3.8-.79-3.2-1.28-5.2-4.55-5.35-4.76-.15-.21-1.2-1.6-1.2-3.05 0-1.45.76-2.16 1.03-2.46.27-.3.59-.37.79-.37h.57c.18 0 .43-.07.67.51.24.59.82 2.03.89 2.18.07.15.12.32.02.52-.1.2-.16.32-.31.5-.16.18-.33.39-.47.52-.16.16-.32.34-.14.66.18.32.79 1.3 1.7 2.1 1.17 1.04 2.15 1.36 2.46 1.52.31.16.49.13.67-.08.18-.2.77-.9.98-1.21.2-.31.4-.26.67-.16.27.1 1.73.82 2.03.97.3.15.5.22.57.35.07.12.07.72-.17 1.4z"/></svg></a>
          <a class="ph-share-link" href="#" data-ph-share-net="facebook" aria-label="Share on Facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.9v3h2.6V21h3z"/></svg></a>
          <a class="ph-share-link" href="#" data-ph-share-net="x" aria-label="Share on X"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
          <a class="ph-share-link" href="#" data-ph-share-net="linkedin" aria-label="Share on LinkedIn"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3zm7 0h3.8v1.5h.1c.5-.95 1.8-1.95 3.7-1.95 4 0 4.7 2.6 4.7 6v5.45h-4v-4.8c0-1.15 0-2.65-1.6-2.65s-1.9 1.25-1.9 2.55v4.9h-4z"/></svg></a>
          <button class="ph-share-link ph-share-copy" type="button" data-ph-share-net="copy" aria-label="Copy link"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1.5 1.5"/><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1.5-1.5"/></svg></button>
        </div>
        <ul class="ph-trust-list">
          <li>{{ ph_address_nursery }}</li>
          <li>Clear-trunk (CT) heights, priced per specimen</li>
          <li>Trade lists on request</li>
        </ul>
      </div>
    </div>
    <section class="ph-product-panel">
      <p class="ph-kicker">Specimen</p>
      <h2 class="ph-h3">Details</h2>
      <dl class="ph-spec">
        <div class="ph-spec-row">
          <dt>Species</dt>
          <dd>{{ product.category_name }}</dd>
        </div>
        <div class="ph-spec-row">
          <dt>Size</dt>
          <dd data-ph-spec-size>—</dd>
        </div>
        <div class="ph-spec-row">
          <dt>SKU</dt>
          <dd data-ph-spec-sku>—</dd>
        </div>
        <div class="ph-spec-row">
          <dt>Unit</dt>
          <dd>{% if product.unit %}{{ product.unit }}{% else %}NOS{% endif %}</dd>
        </div>
        <div class="ph-spec-row">
          <dt>Availability</dt>
          <dd data-ph-spec-stock>—</dd>
        </div>
      </dl>
      {% if product.description %}<div class="ph-copy" style="margin-top:24px;">{{ product.description }}</div>{% endif %}
    </section>
    <p class="ph-copy" style="margin-top:32px;">
      <a class="ph-text-link" href="/all-collections">Back to collections</a>
    </p>
    <div data-zs-recommended-products></div>
  </div>
</section>
{% if product %}
{% assign ph_avail = "InStock" %}
{% assign ph_any_open = false %}
{% for v in product.variants %}{% if v.is_out_of_stock == false && v.is_available_for_purchase != false %}{% assign ph_any_open = true %}{% endif %}{% endfor %}
{% if product.variants | size > 0 && ph_any_open == false %}{% assign ph_avail = "OutOfStock" %}{% endif %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Product","name":"{{ product.name }}","url":"{{ product.url }}"{% if product.images %},"image":"{{ product.images[0].url }}/1600x1600"{% endif %}{% if product.short_description %},"description":"{{ product.short_description }}"{% endif %},"offers":{"@type":"Offer","price":"{% if product.has_variant_price %}{{ product.starts_with }}{% else %}{{ product.selling_price }}{% endif %}","priceCurrency":"{% if currency.code %}{{ currency.code }}{% else %}AED{% endif %}","availability":"{{ ph_avail }}","url":"{{ product.url }}"}}
</script>
{% endif %}
{% endblock %}
