{% extends "_theme" %} {% block content %} <section class="ph-store ph-selection-page">   <div class="ph-wrap">     <p class="ph-kicker">Nursery</p>
    <h1 class="ph-h2">Your wishlist</h1>     <p class="ph-lead" data-ph-wish-signin hidden>Sign in to view the specimens you saved.</p>     <div class="ph-product-grid" data-ph-wish-list{% if wishlist[0].variants | size == 0 %} hidden{% endif %}>       {% for variant in wishlist[0].variants %}       <article class="ph-product-card ph-wish-card" data-ph-wish-card data-ph-wish-variant="{{ variant.variant_id }}">         <a href="{{ variant.url }}">           <div class="ph-product-photo">             {% if variant.images %}               {% assign wimg = variant.images[0].url %}               {% if variant.images[0].is_placeholder_image == false %}{% assign wimg = variant.images[0].url + '/400x400' %}{% endif %}               <img src="{{ wimg }}" alt="{{ variant.name }}" loading="lazy">             {% endif %}           </div>           <div class="ph-card-body">             <h3 class="ph-h3">{{ variant.name }}</h3>             {% if !variant.hide_price %}             <p class="ph-price">               <span data-zs-selling-price="{{ variant.rate }}">{{ currency.symbol }}{{ variant.rate }}</span>               {% if variant.label_price && variant.label_price > variant.rate %}<span class="ph-price-note">{{ currency.symbol }}{{ variant.label_price }}</span>{% endif %}             </p>             {% endif %}             <span class="ph-more">View plant</span>           </div>         </a>         <div class="ph-wish-actions">           {% if variant.is_out_of_stock == false %}           <button class="ph-btn ph-wish-add" type="button" data-ph-wish-add data-ph-wish-variant="{{ variant.variant_id }}">Add to selection</button>           {% endif %}           <button class="ph-text-link ph-wish-remove" type="button" data-ph-wish-remove data-ph-wish-variant="{{ variant.variant_id }}">Remove</button>         </div>       </article>       {% endfor %}     </div>     <p class="ph-lead" data-ph-wish-empty{% if wishlist[0].variants | size != 0 %} hidden{% endif %}>Your wishlist is empty.</p>     <p style="margin-top:32px;"><a class="ph-btn" href="/all-collections">Browse collections</a></p>   </div> </section> {% endblock %}