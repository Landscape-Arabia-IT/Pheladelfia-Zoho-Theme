<!DOCTYPE html>
{% include "_site-data" %}
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <script>window.zs_site_resource_path = window.zs_site_resource_path || "";</script>
  <meta name="ph-theme-build" content="pheladelfia-20261124-v830">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script id="ph-language-bootstrap">(function(){
    try{
      var add=EventTarget.prototype.addEventListener, rem=EventTarget.prototype.removeEventListener;
      EventTarget.prototype.addEventListener=function(t,f,o){ if(t==="unload" && this===window){ t="pagehide"; } return add.call(this,t,f,o); };
      EventTarget.prototype.removeEventListener=function(t,f,o){ if(t==="unload" && this===window){ t="pagehide"; } return rem.call(this,t,f,o); };
    }catch(e){}
    var l="",m=null;
    try{l=localStorage.getItem("ph_lang_v2")||"";}catch(e){}
    try{m=document.cookie.match(/(?:^|; )ph_lang_v2=([^;]+)/);}catch(e){}
    if(l!=="ar"&&l!=="en") l=m&&(m[1]==="ar"||m[1]==="en")?m[1]:"en";
    if(l==="ar"){
      var h=document.documentElement;
      h.setAttribute("lang","ar"); h.setAttribute("dir","rtl"); h.className+=" ph-ar";
      var pre=document.createElement("link"); pre.rel="preconnect"; pre.href="https://fonts.gstatic.com"; pre.crossOrigin="";
      var arFont=document.createElement("link"); arFont.rel="stylesheet"; arFont.href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap";
      document.head.appendChild(pre); document.head.appendChild(arFont);
    }
    try{localStorage.setItem("ph_lang_v2",l);}catch(e){}
    try{if(!m||m[1]!==l) document.cookie="ph_lang_v2="+l+"; path=/; max-age=31536000; SameSite=Lax";}catch(e){}
  })();</script>
  {% if page.is_portal_enabled %}
  <script id="ph-auth-state">
  (function () {
    var html = document.documentElement;
    var requestId = 0;
    var activeController = null;
    var checkPending = false;
    var timeout = 4000;
    var labels = {
      "Account": "حسابي",
      "My account": "حسابي",
      "Dashboard": "لوحة التحكم",
      "My orders": "طلباتي",
      "Wishlist": "قائمة الأمنيات",
      "My addresses": "عناويني",
      "Sign out": "تسجيل الخروج",
      "Sign in": "تسجيل الدخول"
    };
    var portalRoutes = { account: "/account/profile" };
    var portalMenu = [
      ["Dashboard", "/account/profile"],
      ["My orders", "/account/orders"],
      ["My addresses", "/account/address"],
      ["Sign out", "/account/logout"]
    ];
    html.classList.add("ph-auth-pending");

    function arabic() {
      return String(html.getAttribute("lang") || "").toLowerCase().indexOf("ar") === 0;
    }

    function labelFor(value) {
      return arabic() ? (labels[value] || value) : value;
    }

    function beginPending() {
      html.classList.remove("ph-auth-in", "ph-auth-out");
      html.classList.add("ph-auth-pending");
      var out = document.querySelectorAll("[data-ph-auth-out]");
      for (var k = 0; k < out.length; k++) {
        out[k].setAttribute("inert", "");
        out[k].setAttribute("aria-hidden", "true");
      }
      var slots = document.querySelectorAll("[data-ph-auth-slot]");
      for (var i = 0; i < slots.length; i++) {
        var link = slots[i].querySelector("[data-ph-auth-rendered]");
        if (link) link.remove();
        slots[i].hidden = true;
        slots[i].setAttribute("inert", "");
        slots[i].setAttribute("aria-hidden", "true");
      }
      var wishlistBtns = document.querySelectorAll("[data-ph-auth-wishlist]");
      for (var w = 0; w < wishlistBtns.length; w++) {
        wishlistBtns[w].hidden = true;
        wishlistBtns[w].setAttribute("inert", "");
        wishlistBtns[w].setAttribute("aria-hidden", "true");
      }
      var mobile = document.querySelector("[data-ph-mobile-auth]");
      if (mobile) {
        mobile.setAttribute("href", "/signin");
        mobile.setAttribute("aria-label", labelFor("Sign in"));
        mobile.setAttribute("title", labelFor("Sign in"));
        mobile.setAttribute("inert", "");
        mobile.setAttribute("aria-hidden", "true");
      }
    }

    function renderSlot(slot) {
      var route = slot.getAttribute("data-ph-auth-slot");
      if (route === "accountmenu") {
        renderAccountMenu(slot);
        return;
      }
      var href = portalRoutes[route] || "";
      if (!href) return;
      var label = slot.getAttribute("data-ph-auth-label") || "";
      var template = slot.querySelector("template");
      var link = document.createElement("a");
      link.setAttribute("data-ph-auth-rendered", "");
      link.setAttribute("href", href);
      link.className = slot.getAttribute("data-ph-auth-class") || "";
      link.setAttribute("aria-label", labelFor(label));
      var title = slot.getAttribute("data-ph-auth-title");
      if (title) link.setAttribute("title", labelFor(title));
      if (template && template.content && template.content.querySelector("svg")) {
        link.appendChild(template.content.cloneNode(true));
        var screenReaderLabel = link.querySelector(".ph-sr-only");
        if (screenReaderLabel) screenReaderLabel.textContent = labelFor(label);
      } else {
        link.textContent = labelFor(label);
      }
      slot.appendChild(link);
      slot.hidden = false;
      slot.removeAttribute("inert");
      slot.removeAttribute("aria-hidden");
    }

    function renderAccountMenu(slot) {
      var details = document.createElement("details");
      details.className = "ph-account-menu";
      details.setAttribute("data-ph-auth-rendered", "");
      var summary = document.createElement("summary");
      summary.className = slot.getAttribute("data-ph-auth-class") || "";
      var label = slot.getAttribute("data-ph-auth-label") || "Account";
      var template = slot.querySelector("template");
      if (template && template.content && template.content.querySelector("svg")) {
        summary.appendChild(template.content.cloneNode(true));
        var screenReaderLabel = summary.querySelector(".ph-sr-only");
        if (screenReaderLabel) screenReaderLabel.textContent = labelFor(label);
      } else {
        summary.textContent = labelFor(label);
      }
      details.appendChild(summary);
      var list = document.createElement("ul");
      portalMenu.forEach(function (item) {
        var li = document.createElement("li");
        var itemLink = document.createElement("a");
        itemLink.href = item[1];
        itemLink.textContent = labelFor(item[0]);
        li.appendChild(itemLink);
        list.appendChild(li);
      });
      details.appendChild(list);
      slot.appendChild(details);
      slot.hidden = false;
      slot.removeAttribute("inert");
      slot.removeAttribute("aria-hidden");
    }

    function applyState(signedIn) {
      var out = document.querySelectorAll("[data-ph-auth-out]");
      for (var i = 0; i < out.length; i++) {
        if (signedIn) {
          out[i].hidden = true;
          out[i].setAttribute("inert", "");
          out[i].setAttribute("aria-hidden", "true");
        }
        else {
          out[i].hidden = false;
          out[i].removeAttribute("inert");
          out[i].removeAttribute("aria-hidden");
        }
      }
      var slots = document.querySelectorAll("[data-ph-auth-slot]");
      for (var j = 0; j < slots.length; j++) {
        if (signedIn) renderSlot(slots[j]);
        else {
          var link = slots[j].querySelector("[data-ph-auth-rendered]");
          if (link) link.remove();
          slots[j].hidden = true;
          slots[j].setAttribute("inert", "");
          slots[j].setAttribute("aria-hidden", "true");
        }
      }
      var wishlistBtns = document.querySelectorAll("[data-ph-auth-wishlist]");
      for (var w = 0; w < wishlistBtns.length; w++) {
        wishlistBtns[w].hidden = !signedIn;
        if (signedIn) {
          wishlistBtns[w].removeAttribute("inert");
          wishlistBtns[w].removeAttribute("aria-hidden");
        } else {
          wishlistBtns[w].setAttribute("inert", "");
          wishlistBtns[w].setAttribute("aria-hidden", "true");
        }
      }
      if (signedIn && window.__phWishlistSync) window.__phWishlistSync();
      var mobile = document.querySelector("[data-ph-mobile-auth]");
      if (mobile) {
        var mobileLabel = signedIn ? "Account" : "Sign in";
        mobile.setAttribute("href", signedIn ? "/account" : "/signin");
        mobile.setAttribute("aria-label", labelFor(mobileLabel));
        mobile.setAttribute("title", labelFor(mobileLabel));
        mobile.removeAttribute("inert");
        mobile.removeAttribute("aria-hidden");
      }
      html.classList.remove("ph-auth-pending");
      html.classList.toggle("ph-auth-in", signedIn);
      html.classList.toggle("ph-auth-out", !signedIn);
    }

    function responseIsSignedIn(response) {
      if (!response || response.status !== 200 || !response.ok || response.redirected !== false) return false;
      var url;
      if (!response.url) return false;
      try { url = new URL(response.url); }
      catch (error) { return false; }
      var path = url.pathname.replace(/\/+$/, "") || "/";
      var contentType = response.headers && response.headers.get("content-type");
      return url.origin === window.location.origin
        && path === "/portaluser/userProfile"
        && typeof contentType === "string"
        && /^application\/json(?:\s*;|$)/i.test(contentType);
    }

    function verify() {
      var current = ++requestId;
      if (activeController) activeController.abort();
      beginPending();
      checkPending = true;
      var controller = window.AbortController ? new AbortController() : null;
      activeController = controller;
      var options = {
        credentials: "same-origin",
        cache: "no-store",
        redirect: "follow"
      };
      if (controller) options.signal = controller.signal;
      var settled = false;
      var timer = window.setTimeout(function () {
        settled = true;
        if (controller) {
          if (activeController === controller) activeController = null;
          controller.abort();
        }
        if (current === requestId) {
          checkPending = false;
          applyState(false);
        }
      }, timeout);

      function finish(signedIn) {
        if (settled) return;
        settled = true;
        window.clearTimeout(timer);
        if (activeController === controller) activeController = null;
        if (current === requestId) {
          checkPending = false;
          applyState(signedIn);
        }
      }

      try {
        window.fetch("/portaluser/userProfile", options).then(function (response) {
          var signedIn = responseIsSignedIn(response);
          if (response.body && response.body.cancel) {
            try {
              var cancelled = response.body.cancel();
              if (cancelled && cancelled.catch) cancelled.catch(function () {});
            } catch (error) {}
          }
          finish(signedIn);
        }, function () {
          finish(false);
        });
      } catch (error) {
        finish(false);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", verify, { once: true });
    } else {
      verify();
    }
    window.addEventListener("pageshow", function (event) {
      if (event.persisted) verify();
    });
    window.addEventListener("focus", function () {
      if (!checkPending && document.readyState !== "loading") verify();
    });
    document.addEventListener("click", function (event) {
      var openMenus = document.querySelectorAll("details.ph-account-menu[open]");
      for (var m = 0; m < openMenus.length; m++) {
        if (!openMenus[m].contains(event.target)) openMenus[m].removeAttribute("open");
      }
    });
  })();
  </script>
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&display=swap">
  <title>{% if page.title %}{{ page.title }}{% else %}Pheladelfia{% endif %}</title>
  {{ page.meta_tags }}
  {% assign ph_head_path = page.url %}
  {% if ph_head_path contains 'cart' || ph_head_path contains 'checkout' || ph_head_path contains 'search' || ph_head_path contains 'account' || ph_head_path contains 'login' || ph_head_path contains 'register' %}<meta name="robots" content="noindex,follow">{% endif %}
  {% comment %}canonical, og:url, og:type, og:title, og:image and twitter:* are emitted by page.meta_tags — do not duplicate them here.{% endcomment %}
  <meta property="og:site_name" content="Pheladelfia Agricultural LLC">
  <meta property="og:description" content="Specialist nursery and specimen-tree supplier — Pheladelfia Agricultural LLC, Abu Dhabi since 2004.">
  {% comment %}og-default social banner uploaded by client; TODO: verify it is 1200x630.{% endcomment %}
  <meta property="og:image" content="{{ ph_img }}/luxury_nursery_palm_rows_social_banner.jpeg">
  <meta name="twitter:card" content="summary_large_image">
  <script type="application/ld+json">
  {"@context":"https://schema.org","@graph":[
    {"@type":"Organization","@id":"https://www.pheladelfia.com/#organization","name":"Pheladelfia Agricultural LLC","url":"https://www.pheladelfia.com","logo":"{{ ph_img }}/logo-full.png","email":"nursery@pheladelfia.com","telephone":"+97125551662","sameAs":["{{ ph_social_instagram }}","{{ ph_social_facebook }}","{{ ph_social_linkedin }}","{{ ph_social_x }}"],"address":{"@type":"PostalAddress","streetAddress":"Farm No. 563 & 564, Al Ajban, Muwailih","addressLocality":"Abu Dhabi","addressCountry":"AE"}},
    {"@type":"LocalBusiness","@id":"https://www.pheladelfia.com/#nursery","name":"Pheladelfia Agricultural LLC — Al Ajban Nursery","parentOrganization":{"@id":"https://www.pheladelfia.com/#organization"},"url":"https://www.pheladelfia.com","telephone":"+97125551662","email":"nursery@pheladelfia.com","image":"{{ ph_img }}/palm-nursery-rows.jpg","priceRange":"$$","address":{"@type":"PostalAddress","streetAddress":"Farm No. 563 & 564, Al Ajban, Muwailih","addressLocality":"Abu Dhabi","addressCountry":"AE"},"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Saturday","Sunday","Monday","Tuesday","Wednesday","Thursday"],"opens":"08:00","closes":"18:00"}]},
    {"@type":"LocalBusiness","@id":"https://www.pheladelfia.com/#warsan-branch","name":"Pheladelfia Agricultural LLC — Warsan Branch","parentOrganization":{"@id":"https://www.pheladelfia.com/#organization"},"url":"https://www.pheladelfia.com","telephone":"+97125551662","address":{"@type":"PostalAddress","streetAddress":"Warsan","addressLocality":"Dubai","addressCountry":"AE"}},
    {"@type":"WebSite","@id":"https://www.pheladelfia.com/#website","url":"https://www.pheladelfia.com","name":"Pheladelfia Agricultural LLC","publisher":{"@id":"https://www.pheladelfia.com/#organization"},"potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://www.pheladelfia.com/search-products?q={search_term_string}"},"query-input":"required name=search_term_string"}}
  ]}
  </script>
  {{ page.stylesheets }}
  <template id="ph-saved-header-code">{{ page.header_code }}</template>
  <script>
  (function () {
    var source = document.getElementById("ph-saved-header-code");
    if (!source || !source.content) return;
    var nodes = source.content.querySelectorAll("script,style,link,meta");
    for (var i = 0; i < nodes.length; i++) {
      var original = nodes[i];
      if (original.tagName === "STYLE" && /section\.settings|\.ph-header/.test(original.textContent)) continue;
      var copy = document.createElement(original.tagName.toLowerCase());
      for (var a = 0; a < original.attributes.length; a++) {
        copy.setAttribute(original.attributes[a].name, original.attributes[a].value);
      }
      if (copy.tagName === "SCRIPT" && !original.hasAttribute("async")) copy.async = false;
      copy.textContent = original.textContent;
      document.head.appendChild(copy);
    }
    source.parentNode.removeChild(source);
  })();
  </script>
  <style type="text/css">{{ page.custom_css }}</style>
</head>
<body class="ph-body{% if page.is_home_page %} is-home{% endif %}">
<a class="ph-skip-link" href="#ph-main">Skip to content</a>

<header class="ph-header">
  <!-- Announcement bar -->
  <div class="ph-topbar">
    <div class="ph-wrap">
      <span class="ph-topbar-msg">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>
        Premium Palms &amp; Trees — Grown &amp; sourced for the UAE
      </span>
      <span class="ph-topbar-contact">
        <a href="{{ ph_phone_tel }}" dir="ltr">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
          {{ ph_phone_display }}
        </a>
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          {{ ph_hours }}
        </span>
      </span>
    </div>
  </div>

  <!-- Main bar -->
  <div class="ph-header-top">
    <button class="ph-icon-btn ph-menu-toggle" type="button" data-ph-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="ph-mobile-navigation">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>

    <a class="ph-logo" href="/" aria-label="Pheladelfia home">
      {% if page.logo.url %}
      <img class="ph-store-logo" src="{{ page.logo.url }}" alt="Pheladelfia Agricultural">
      {% else %}
      <img class="ph-store-logo" src="{{ ph_img }}/logo-mark.png" alt="Pheladelfia Agricultural" onerror="this.style.display='none'">
      {% endif %}
      <span class="ph-logo-sub">
        <b>Pheladelfia</b>
        <span>Agricultural LLC</span>
      </span>
    </a>

    <form class="ph-search" action="{% if page.search_url %}{{ page.search_url }}{% else %}/search{% endif %}" method="get" role="search">
      <select aria-label="All categories" data-ph-search-filter>
        <option value="">All categories</option>
        <option value="outdoor">Outdoor</option>
        <option value="indoor">Indoor</option>
      </select>
      <input type="search" name="q" placeholder="Search palms, trees, shrubs…" aria-label="Search" autocomplete="off" aria-expanded="false" aria-controls="ph-search-suggest">
      <button type="submit" aria-label="Search">Search</button>
      <div class="ph-suggest" id="ph-search-suggest" data-ph-suggest hidden></div>
    </form>

    <div class="ph-header-tools">
      <button class="ph-lang" type="button" data-ph-lang-toggle data-ph-no-translate aria-label="English / العربية">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
        <span class="ph-lang-to-ar" lang="ar"><span class="ph-lang-word">العربية</span></span>
        <span class="ph-lang-to-en" lang="en"><span class="ph-lang-word">EN</span></span>
      </button>
      {% if page.is_portal_enabled %}
      <span class="ph-account">
        <a class="ph-account-link ph-auth-btn ph-auth-signin" href="/signin" data-ph-auth-out>Sign in</a>
        <a class="ph-account-link ph-auth-btn ph-auth-register" href="/signup" data-ph-auth-out>Register</a>
        <span class="ph-auth-slot" data-ph-auth-slot="accountmenu" data-ph-auth-label="Account" data-ph-auth-title="Account" data-ph-auth-class="ph-icon-btn" hidden inert aria-hidden="true"><template><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 22v-2a8 8 0 0 1 16 0v2"/></svg><span class="ph-sr-only">Account</span></template></span>
        <a class="ph-icon-btn" href="/wishlist" data-ph-auth-wishlist data-ph-wish-link hidden aria-label="Your wishlist" title="Wishlist">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.3-9C1.2 8.6 3 5 6.6 5c2 0 3.6 1.1 4.4 2.6C11.8 6.1 13.4 5 15.4 5 19 5 20.8 8.6 19.3 12c-1.8 4.4-7.3 9-7.3 9z"/></svg>
          {% assign ph_wish_total = 0 %}
          {% if wishlist %}{% if wishlist[0] %}{% assign ph_wish_total = wishlist[0].variants | size %}{% endif %}{% endif %}
          <span class="ph-cart-count" data-ph-wish-count {% if ph_wish_total > 0 %}{% else %}hidden{% endif %}>{% if ph_wish_total > 0 %}{{ ph_wish_total }}{% endif %}</span>
        </a>
      </span>
      {% endif %}
      {% if page.is_delivery_location_enabled %}{% include '_store-select-location' %}{% endif %}
      {% if page.is_multi_currency_enabled %}
      <span class="ph-currency" data-ph-currency hidden>
        <select class="ph-currency-select" data-ph-currency-select aria-label="Currency" hidden></select>
      </span>
      {% endif %}
      <a class="ph-icon-btn" href="/cart" aria-label="Your cart" data-ph-cart-link aria-haspopup="dialog">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 7h15l-1.6 9H8L6 7z"/><path d="M6 7L5 4H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
        <span class="ph-cart-count" data-ph-cart-count {% if cart.count %}{% else %}hidden{% endif %}>{% if cart.count %}{{ cart.count }}{% endif %}</span>
      </a>
    </div>
  </div>

  <!-- Nav (desktop row / mobile drawer) -->
  <nav class="ph-nav" id="ph-mobile-navigation" data-ph-nav aria-label="Main" aria-hidden="false">
    <div class="ph-nav-head">
      <span class="ph-nav-title">Menu</span>
      <button class="ph-nav-close" type="button" data-ph-menu-close aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <form class="ph-nav-search" action="{% if page.search_url %}{{ page.search_url }}{% else %}/search-products{% endif %}" method="get" role="search">
      <label class="ph-sr-only" for="ph-mobile-search">Search</label>
      <input id="ph-mobile-search" type="search" name="q" placeholder="Search palms, trees, shrubs…" required aria-expanded="false" aria-controls="ph-nav-search-suggest">
      <button class="ph-btn" type="submit">Search</button>
      <div class="ph-suggest" id="ph-nav-search-suggest" data-ph-suggest hidden></div>
    </form>
    <ul class="ph-nav-list">
      <li><a href="/">Home</a></li>
      <li class="ph-drop ph-drop-mega">
        <a href="/all-collections">Collections</a>
        <div class="ph-drop-menu ph-mega">
          <a class="ph-mega-all" href="/all-collections">All collections <span aria-hidden="true">→</span></a>
          <div class="ph-mega-col">
            <h5>Outdoor Plants</h5>
            <a href="{{ ph_url_palm_trees }}">Palm Trees</a>
            <a class="ph-mega-sub" href="{{ ph_url_washingtonia }}">Washingtonia robusta</a>
            <a href="{{ ph_url_trees }}">Trees</a>
            <a href="{{ ph_url_rare_trees }}">Rare &amp; Ancient Trees</a>
            <a href="{{ ph_url_cacti }}">Cacti &amp; Succulents</a>
          </div>
          <div class="ph-mega-col">
            <h5>More Outdoor</h5>
            <a href="{{ ph_url_shrubs }}">Shrubs &amp; Ground Cover</a>
            <a href="{{ ph_url_climbers }}">Climbers</a>
            <a href="{{ ph_url_art }}">Art &amp; Sculptures</a>
          </div>
          <div class="ph-mega-col">
            <h5>Indoor &amp; Decor</h5>
            <a href="{{ ph_url_indoor }}">Indoor Ornamental Plants</a>
            <a href="{{ ph_url_flowers }}">Fresh Flowers &amp; Bouquets</a>
            <a href="{{ ph_url_artificial }}">Artificial Plants</a>
          </div>
          <div class="ph-mega-col">
            <h5>Garden &amp; Nursery Supply</h5>
            <a href="{{ ph_url_fertilizers }}">Fertilizers &amp; Soil Amendments</a>
            <a href="{{ ph_url_seeds }}">Seeds &amp; Planting Stock</a>
            <a href="{{ ph_url_tools }}">Tools &amp; Equipment</a>
          </div>
        </div>
      </li>
      <li><a href="/services">Services</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/join-us">Join Us</a></li>
      <li><a href="/contact">Contact</a></li>
      <li class="ph-nav-cta-item"><a class="ph-nav-cta" href="{{ ph_url_palm_trees }}">Shop palms <span class="ph-arrow" aria-hidden="true">→</span></a></li>
    </ul>
    <div class="ph-nav-extra">
      <a class="ph-btn" href="/contact">Inquire</a>
      {% if page.is_portal_enabled %}
      <a class="ph-auth-btn ph-auth-signin" href="/signin" data-ph-auth-out>Sign in</a>
      <a class="ph-auth-btn ph-auth-register" href="/signup" data-ph-auth-out>Register</a>
      <span class="ph-auth-slot" data-ph-auth-slot="accountmenu" data-ph-auth-label="Account" data-ph-auth-class="ph-auth-btn" hidden inert aria-hidden="true"></span>
      {% endif %}
    </div>
  </nav>
  <div class="ph-nav-backdrop" data-ph-menu-close></div>
</header>

<main id="ph-main" class="ph-main">{% block content %}{% endblock %}</main>

<!-- Cart drawer -->
<div class="ph-drawer" data-ph-drawer aria-hidden="true" inert>
  <div class="ph-drawer-backdrop" data-ph-drawer-close></div>
  <aside class="ph-drawer-panel" role="dialog" aria-modal="true" aria-label="Your cart" tabindex="-1">
    <header class="ph-drawer-head">
      <div>
        <p class="ph-kicker">Nursery</p>
        <h2 class="ph-drawer-title">Your selection</h2>
      </div>
      <button class="ph-icon-btn" type="button" data-ph-drawer-close aria-label="Close selection">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>
    <div class="ph-drawer-body" data-ph-drawer-items></div>
    <footer class="ph-drawer-foot" data-ph-drawer-foot hidden>
      <div class="ph-drawer-sub">
        <span>Subtotal</span>
        <strong data-ph-drawer-subtotal></strong>
      </div>
      <p class="ph-drawer-note">{{ ph_vat_note }} · {{ ph_delivery_note }}</p>
      <a class="ph-btn" data-ph-drawer-checkout href="/checkout">Continue to checkout</a>
      <a class="ph-text-link" href="/cart">View full selection</a>
    </footer>
  </aside>
</div>

<footer class="ph-footer">
  <div class="ph-wrap">
    <div class="ph-footer-grid">
      <div>
        <span class="ph-footer-logo">
          <img src="{{ ph_img }}/logo-full.png" alt="Pheladelfia Agricultural LLC" onerror="this.parentElement.style.display='none'">
        </span>
        <p class="ph-footer-about">A specialist nursery and specimen-tree supplier in Abu Dhabi since 2004 — growing, sourcing and delivering design-grade plants across the UAE and Gulf.</p>
      </div>
      <div>
        <h3>Shop</h3>
        <ul>
          <li><a href="{{ ph_url_palm_trees }}">Palm Trees</a></li>
          <li><a href="{{ ph_url_trees }}">Trees</a></li>
          <li><a href="{{ ph_url_shrubs }}">Shrubs &amp; Ground Cover</a></li>
          <li><a href="{{ ph_url_indoor }}">Indoor Plants</a></li>
          <li><a href="{{ ph_url_fertilizers }}">Pots &amp; Supplies</a></li>
          <li><a href="/all-collections">All collections</a></li>
        </ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul>
          <li><a href="/services">Services</a></li>
          <li><a href="/about">About us</a></li>
          <li><a href="/join-us">Join Us</a></li>
      <li><a href="/contact">Contact</a></li>
          <li><a href="{{ ph_company_pdf }}" target="_blank" rel="noopener">Company profile (PDF)</a></li>
          {% if page.is_portal_enabled %}<li><span class="ph-auth-slot" data-ph-auth-slot="account" data-ph-auth-label="My account" data-ph-auth-class="ph-footer-account-link" hidden inert aria-hidden="true"><template>My account</template></span></li>{% endif %}
        </ul>
      </div>
      <div>
        <h3>Visit &amp; contact</h3>
        <ul class="ph-footer-contact">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <span>{{ ph_address_nursery }}<br>{{ ph_address_branch }}<br>{{ ph_po_box }}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
            <a href="{{ ph_phone_tel }}" dir="ltr">{{ ph_phone_display }}</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            <a href="mailto:{{ ph_email }}">{{ ph_email }}</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
            <a href="{{ ph_website }}" target="_blank" rel="noopener">www.pheladelfia.com</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            <span>{{ ph_hours }}</span>
          </li>
        </ul>
      </div>
    </div>
    <div class="ph-social" aria-label="Social media">
      <a class="ph-social-link" href="{{ ph_social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg></a>
      <a class="ph-social-link" href="{{ ph_social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.9v3h2.6V21h3z"/></svg></a>
      <a class="ph-social-link" href="{{ ph_social_linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3zm7 0h3.8v1.5h.1c.5-.95 1.8-1.95 3.7-1.95 4 0 4.7 2.6 4.7 6v5.45h-4v-4.8c0-1.15 0-2.65-1.6-2.65s-1.9 1.25-1.9 2.55v4.9h-4z"/></svg></a>
      <a class="ph-social-link" href="{{ ph_social_x }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
    </div>
    <div class="ph-footer-bottom">
      <span>© <span data-ph-year>2026</span> Pheladelfia Agricultural LLC. All rights reserved.</span>
      <span>{{ ph_vat_short }}</span>
    </div>
  </div>
</footer>

<div hidden aria-hidden="true">
  <div data-portal-loggedout><a data-portal-signin href="/signin">Sign in</a><a data-portal-signup href="/signup">Register</a></div>
  <div data-portal-loggedin><span data-portal-profile><span data-portal-user-name></span></span><a data-portal-logout href="/account/logout">Sign out</a></div>
</div>

{% if page.is_delivery_location_enabled %}<div id="delivery_availability_popup"></div>{% endif %}

<div class="ph-qv-overlay" data-ph-qv-overlay hidden>
  <div class="ph-qv-modal" id="product_quick_look" role="dialog" aria-modal="true" aria-label="Quick view"></div>
</div>

{% comment %}WhatsApp business number confirmed by client; button hides itself if the variable is ever emptied.{% endcomment %}
{% if ph_whatsapp_url != "" %}
<a class="ph-wa-float" href="{{ ph_whatsapp_url }}" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.83 14.12c-.24.68-1.42 1.3-1.96 1.35-.5.05-1.13.24-3.8-.79-3.2-1.28-5.2-4.55-5.35-4.76-.15-.21-1.2-1.6-1.2-3.05 0-1.45.76-2.16 1.03-2.46.27-.3.59-.37.79-.37h.57c.18 0 .43-.07.67.51.24.59.82 2.03.89 2.18.07.15.12.32.02.52-.1.2-.16.32-.31.5-.16.18-.33.39-.47.52-.16.16-.32.34-.14.66.18.32.79 1.3 1.7 2.1 1.17 1.04 2.15 1.36 2.46 1.52.31.16.49.13.67-.08.18-.2.77-.9.98-1.21.2-.31.4-.26.67-.16.27.1 1.73.82 2.03.97.3.15.5.22.57.35.07.12.07.72-.17 1.4z"/></svg>
</a>
{% endif %}

{{ page.scripts }}
{{ page.footer_code }}
<script>
document.querySelectorAll("style").forEach(function (style) {
  var text = style.textContent || "";
  if (text.indexOf("ph-footer__inner") !== -1 && /direction\s*:\s*rtl/.test(text)) style.remove();
});
</script>
</body>
</html>
