<!-- ===== Hero ===== -->
<section class="ph-hero ph-hero-retail" id="top">
  <div class="ph-hero-retail-grid">
    <div class="ph-hero-copy">
      <span class="ph-eyebrow ph-anim ph-anim-1">Abu Dhabi nursery · Est. 2004</span>
      <h1 class="ph-hero-title ph-anim ph-anim-2">Premium Palms &amp; Trees, <em class="ph-text-gradient-gold">Grown in the UAE</em></h1>
      <p class="ph-hero-lead ph-anim ph-anim-3">Specimen palms, native trees and flowering shrubs — acclimatized in our Abu Dhabi nursery and delivered ready to plant across the Emirates.</p>
      <div class="ph-hero-actions ph-anim ph-anim-4">
        <a class="ph-btn ph-btn-gold" href="/all-collections">Shop Plants <span aria-hidden="true">→</span></a>
        <a class="ph-btn ph-btn-outline" href="{{ ph_url_palm_trees }}">Browse Palms</a>
      </div>
      <ul class="ph-hero-facts">
        <li><a href="/nursery">Nursery: Al Ajban, Abu Dhabi</a></li>
        <li>{{ ph_address_branch }}</li>
        <li>{{ ph_hours }}</li>
      </ul>
    </div>
    <div class="ph-hero-media">
      <img src="{{ ph_img }}/palm-nursery-rows.jpg" alt="Rows of mature Washingtonia palms at the Pheladelfia nursery in Abu Dhabi" fetchpriority="high">
    </div>
  </div>
</section>

<!-- ===== Trust bar ===== -->
<section class="ph-trustbar">
  <div class="ph-wrap">
    <ul class="ph-trust-grid">
      <li class="ph-trust-item">
        <span class="ph-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span>
        <span><span class="ph-trust-label">Since 2004</span><span class="ph-trust-sub">Two decades of growing</span></span>
      </li>
      <li class="ph-trust-item">
        <span class="ph-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg></span>
        <span><span class="ph-trust-label">UAE-adapted plants</span><span class="ph-trust-sub">Acclimatized in Abu Dhabi</span></span>
      </li>
      <li class="ph-trust-item">
        <span class="ph-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg></span>
        <span><span class="ph-trust-label">Delivery across the UAE</span><span class="ph-trust-sub">All seven Emirates</span></span>
      </li>
      <li class="ph-trust-item">
        <span class="ph-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 4 7v5c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7z"/></svg></span>
        <span><span class="ph-trust-label">Project supply</span><span class="ph-trust-sub">Sourcing to delivery</span></span>
      </li>
    </ul>
  </div>
</section>

<!-- ===== Shop by category ===== -->
<section class="ph-section" id="shop">
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-row">
      <div class="ph-sec-head-text">
        <span class="ph-eyebrow">Shop by category</span>
        <h2 class="ph-sec-title">Everything for design-led planting</h2>
        <p class="ph-sec-sub">Browse our nursery by plant type — every item grown or selected for the UAE climate.</p>
      </div>
      <a class="ph-btn ph-btn-outline" href="/all-collections">All collections</a>
    </div>
    <div class="ph-cat-grid ph-cat-shop">
      <a class="ph-cat-card" href="{{ ph_url_palm_trees }}">
        <img src="{{ ph_img }}/palm-grove-fan.jpg" alt="Fan palms at the Pheladelfia nursery" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Fan, date &amp; specimen palms</span>
          <span class="ph-cat-name">Palms <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_trees }}">
        <img src="{{ ph_img }}/ghaf-tree.jpg" alt="Native Ghaf tree" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Shade &amp; native trees</span>
          <span class="ph-cat-name">Trees <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_rare_trees }}">
        <img src="{{ ph_img }}/phoenix-canariensis.jpg" alt="Specimen palm tree" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Heritage &amp; monumental specimens</span>
          <span class="ph-cat-name">Rare &amp; Ancient Trees <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_shrubs }}">
        <img src="{{ ph_img }}/bougainvillea.jpg" alt="Flowering bougainvillea shrub" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Flowering shrubs &amp; ground covers</span>
          <span class="ph-cat-name">Shrubs &amp; Ground Cover <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_indoor }}">
        <img src="{{ ph_img }}/indoor-plants.jpg" alt="Indoor ornamental plants" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">For homes, offices &amp; hotels</span>
          <span class="ph-cat-name">Indoor Plants <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_fertilizers }}">
        <img src="{{ ph_img }}/planters.jpg" alt="Plant pots and garden supplies" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Planters, soil &amp; care</span>
          <span class="ph-cat-name">Pots &amp; Supplies <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
    </div>
  </div>
</section>

<!-- Catalog cards are rendered by the category FACE layout and loaded progressively. -->
<section class="ph-section ph-section-sand" data-ph-best-section>
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-row">
      <div class="ph-sec-head-text">
        <span class="ph-eyebrow">From our nursery</span>
        <h2 class="ph-sec-title">Explore our plants</h2>
      </div>
      <div class="ph-carousel-nav">
        <button class="ph-carousel-btn" type="button" data-ph-carousel-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg></button>
        <button class="ph-carousel-btn" type="button" data-ph-carousel-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
    </div>
    <div class="ph-carousel" data-ph-best-sellers aria-busy="true"></div>
    <p class="ph-copy" data-ph-catalog-status><span data-ph-catalog-loading>Loading plants…</span> <a href="/all-collections">Browse collections</a></p>
  </div>
</section>

<!-- ===== Real departments ===== -->
<section class="ph-section">
  <div class="ph-wrap">
    <div class="ph-dept-grid">
      <a class="ph-dept" href="{{ ph_url_palm_trees }}">
        <img src="{{ ph_img }}/date-palm.jpg" alt="Date palms" loading="lazy">
        <span class="ph-dept-copy">
          <span class="ph-eyebrow">Outdoor Plants</span>
          <strong>Palm Trees</strong>
          <span>Architectural palms. Open this collection to reach species such as Washingtonia robusta.</span>
        </span>
      </a>
      <a class="ph-dept" href="{{ ph_url_indoor }}">
        <img src="{{ ph_img }}/indoor-plants.jpg" alt="Indoor ornamental plants" loading="lazy">
        <span class="ph-dept-copy">
          <span class="ph-eyebrow">Indoor &amp; Decor</span>
          <strong>Indoor Ornamental Plants</strong>
          <span>Interior specimens for hospitality, residences and workplaces.</span>
        </span>
      </a>
      <a class="ph-dept" href="{{ ph_url_shrubs }}">
        <img src="{{ ph_img }}/bougainvillea.jpg" alt="Flowering bougainvillea shrub" loading="lazy">
        <span class="ph-dept-copy">
          <span class="ph-eyebrow">Outdoor Plants</span>
          <strong>Shrubs &amp; Ground Cover</strong>
          <span>Mass planting, edges and ground plane for complete schemes.</span>
        </span>
      </a>
    </div>
  </div>
</section>

<!-- ===== Services ===== -->
<section class="ph-section ph-section-sand" id="home-services">
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-row">
      <div class="ph-sec-head-text">
        <span class="ph-eyebrow">Our Services</span>
        <h2 class="ph-sec-title">The full horticultural supply chain</h2>
        <p class="ph-sec-sub">From sourcing and quality control to logistics, import and export — we manage the full horticultural supply chain so you receive the right plants, in the right condition, on time.</p>
      </div>
      <a class="ph-btn ph-btn-outline" href="/services">Services</a>
    </div>
    <div class="ph-service-tiles">
      <a class="ph-service-tile" href="/services#sourcing"><span>01</span><strong>Plant Sourcing</strong><em>The right material, in the right condition, on schedule.</em></a>
      <a class="ph-service-tile" href="/services#importing"><span>02</span><strong>Importing</strong><em>Specialist plant material, expanded project selection.</em></a>
      <a class="ph-service-tile" href="/services#exporting"><span>03</span><strong>Exporting</strong><em>Documented plant material to regional and international markets.</em></a>
      <a class="ph-service-tile" href="/services#quality"><span>04</span><strong>Quality Assurance</strong><em>Every plant inspected before delivery.</em></a>
      <a class="ph-service-tile" href="/services#purchasing"><span>05</span><strong>Centralized Purchasing</strong><em>One point of contact for coordinated project supply.</em></a>
      <a class="ph-service-tile" href="/services#logistics"><span>06</span><strong>Logistics</strong><em>On time, and in the condition you expect.</em></a>
    </div>
  </div>
</section>

<!-- ===== Why us / story ===== -->
<section class="ph-why ph-section">
  <div class="ph-wrap">
    <div class="ph-why-grid">
      <div class="ph-gold-frame">
        <img src="{{ ph_img }}/palm-single-specimen.jpg" alt="A specimen fan palm at our nursery" loading="lazy">
      </div>
      <div>
        <span class="ph-eyebrow">Why Pheladelfia</span>
        <h2 class="ph-why-title">Rooted in the Emirates for over 20 years</h2>
        <p class="ph-copy">Pheladelfia Agricultural LLC began in 2004 with a simple belief: the region's design ambitions needed mature, design-grade plant material — grown and supplied to a documented standard. Our Abu Dhabi nursery spans more than 1.5 million square feet in Al Ajban, where plants and trees are propagated and grown on to specimen sizes.</p>
        <div class="ph-why-items">
          <div class="ph-why-item">
            <span class="ph-why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21c-4-3-7-6-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4-3 7-7 10z"/></svg></span>
            <h3>Locally acclimatized</h3>
            <p>Every plant is hardened in our Abu Dhabi nursery to thrive in UAE heat, wind and soil.</p>
          </div>
          <div class="ph-why-item">
            <span class="ph-why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19c3-5 7-8 11-9"/></svg></span>
            <h3>Wide variety</h3>
            <p>Explore palms, trees and ground covers, and ask our team about current nursery availability.</p>
          </div>
          <div class="ph-why-item">
            <span class="ph-why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.5 2.7-6 6-6s6 2.5 6 6"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14.5c3 .3 5.5 2.6 5.5 5.5"/></svg></span>
            <h3>Experienced team</h3>
            <p>Horticulturists and supply specialists with 20+ years of regional experience.</p>
          </div>
          <div class="ph-why-item">
            <span class="ph-why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 21V9l8-5 8 5v12"/><path d="M9 21v-6h6v6"/></svg></span>
            <h3>Large-scale capacity</h3>
            <p>Discuss specimen sizes, quantities and delivery schedules with our project supply team.</p>
          </div>
        </div>
        <div class="ph-actions-row">
          <a class="ph-btn" href="/about">About us</a>
          <a class="ph-btn ph-btn-outline" href="/projects">Projects</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== Visit ===== -->
<section class="ph-visit-band" id="visit">
  <div class="ph-wrap ph-visit-grid">
    <div>
      <span class="ph-eyebrow">Visit &amp; contact</span>
      <h2 class="ph-sec-title">The Operational Heart of Pheladelfia</h2>
      <p class="ph-copy">More than 1.5 million square feet in Al Ajban, Abu Dhabi.</p>
      <ul class="ph-visit-list">
        <li>
          <strong>Nursery</strong>
          <span>{{ ph_address_nursery }}</span>
        </li>
        <li>
          <strong>Branch</strong>
          <span>{{ ph_address_branch }}</span>
        </li>
        <li>
          <strong>Opening hours</strong>
          <span>{{ ph_hours }}</span>
        </li>
        <li>
          <strong>Call us</strong>
          <a href="{{ ph_phone_tel }}" dir="ltr">{{ ph_phone_display }}</a>
          <a href="{{ ph_phone_alt_tel }}" dir="ltr">{{ ph_phone_alt_display }}</a>
        </li>
      </ul>
      <div class="ph-actions-row">
        <a class="ph-btn ph-btn-gold" href="/visit">Visit the nursery</a>
        <a class="ph-btn ph-btn-ghost" href="{{ ph_maps_url }}" target="_blank" rel="noopener">Open in Google Maps</a>
      </div>
    </div>
    <div class="ph-visit-photo">
      <img src="{{ ph_img }}/palm-grove-fan.jpg" alt="Fan palms at the Pheladelfia nursery" loading="lazy">
    </div>
  </div>
</section>

