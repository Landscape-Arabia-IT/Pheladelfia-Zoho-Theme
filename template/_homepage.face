<!-- ===== Hero (static) ===== -->
<section class="ph-hero ph-hero-static" id="top">
  <div class="ph-hero-media"><img src="{{ ph_img }}/palm-nursery-rows.jpg" alt="Rows of mature palms at the Pheladelfia nursery in Abu Dhabi" width="1600" height="1067" fetchpriority="high"></div>
  <div class="ph-hero-overlay" aria-hidden="true"></div>
  <div class="ph-wrap">
    <div class="ph-hero-copy">
      <span class="ph-eyebrow ph-anim ph-anim-1">Pheladelfia Agricultural LLC · Est. 2004</span>
      <h1 class="ph-hero-title ph-anim ph-anim-2">Plants, palms &amp; trees for your space</h1>
      <p class="ph-hero-lead ph-anim ph-anim-3">Browse our nursery's palms, specimen trees, indoor plants and garden supplies — grown and sourced for the UAE, with prices and sizes listed online.</p>
      <div class="ph-hero-actions ph-anim ph-anim-4">
        <a class="ph-btn" href="/all-collections">Shop plants</a>
        <a class="ph-btn ph-btn-ghost" href="{{ ph_url_palm_trees }}">Explore palms</a>
      </div>
    </div>
  </div>
</section>

<!-- ===== Shop by category ===== -->
<section class="ph-section">
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-center">
      <span class="ph-eyebrow">Shop by category</span>
      <h2 class="ph-sec-title">Everything for design-led planting</h2>
      <p class="ph-sec-sub">Browse our nursery by plant type — every item grown or selected for the UAE climate.</p>
    </div>
    <div class="ph-cat-grid">
      <a class="ph-cat-card" href="{{ ph_url_palm_trees }}">
        <img src="{{ ph_img }}/palm-grove-fan.jpg" alt="Fan palms at the Pheladelfia nursery" width="800" height="600" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Fan, date &amp; specimen palms</span>
          <span class="ph-cat-name">Palms <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_trees }}">
        <img src="{{ ph_img }}/ghaf-tree.jpg" alt="Native Ghaf tree" width="800" height="600" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Shade &amp; native trees</span>
          <span class="ph-cat-name">Trees <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_rare_trees }}">
        <img src="{{ ph_img }}/phoenix-canariensis.jpg" alt="Specimen palm tree" width="800" height="600" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Heritage &amp; monumental specimens</span>
          <span class="ph-cat-name">Rare &amp; Ancient Trees <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_cacti }}">
        <img src="{{ ph_img }}/cacti-succulents.jpeg" alt="Giant cacti and succulents at the Pheladelfia nursery" width="1264" height="848" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Giant cacti, succulents &amp; Yucca rostrata</span>
          <span class="ph-cat-name">Cacti &amp; Succulents <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_shrubs }}">
        <img src="{{ ph_img }}/bougainvillea.jpg" alt="Flowering bougainvillea shrub" width="800" height="600" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Flowering shrubs &amp; ground covers</span>
          <span class="ph-cat-name">Shrubs &amp; Ground Cover <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_indoor }}">
        <img src="{{ ph_img }}/indoor-plants.jpg" alt="Indoor ornamental plants" width="800" height="600" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">For homes, offices &amp; hotels</span>
          <span class="ph-cat-name">Indoor Plants <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
    </div>
    <p class="ph-cat-more"><a class="ph-text-link" href="/all-collections">All collections &amp; garden supplies <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<!-- ===== Featured plants ===== -->
<section class="ph-section ph-section-sand" data-ph-best-section>
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-row">
      <div class="ph-sec-head-text">
        <span class="ph-eyebrow">From our nursery</span>
        <h2 class="ph-sec-title">Featured plants</h2>
        <p class="ph-sec-sub">Real specimens from our catalogue — prices in AED, exclusive of 5% VAT.</p>
      </div>
      <a class="ph-btn ph-btn-outline ph-btn-sm" href="/all-collections">Shop all plants</a>
    </div>
    <div class="ph-feature-grid" data-ph-best-sellers aria-busy="true"></div>
    <p class="ph-copy" data-ph-catalog-status><span data-ph-catalog-loading>Loading plants…</span> <a href="/all-collections">Browse collections</a></p>
  </div>
</section>

<!-- ===== About Pheladelfia (compact) ===== -->
<section class="ph-section">
  <div class="ph-wrap">
    <div class="ph-about-grid">
      <div class="ph-about-media">
        <img src="{{ ph_img }}/palm-single-specimen.jpg" alt="A specimen fan palm at our nursery" width="800" height="1000" loading="lazy">
      </div>
      <div class="ph-about-copy">
        <span class="ph-eyebrow">About Pheladelfia</span>
        <h2 class="ph-about-title">Growing &amp; supplying the Emirates since 2004</h2>
        <p>Pheladelfia Agricultural LLC is a specialist nursery and specimen-tree supplier based in Al Ajban, Abu Dhabi, with a branch in Warsan, Dubai. For over two decades we have grown, sourced and delivered palms, trees, indoor plants and garden supplies — acclimatised for the UAE climate and backed by documented quality.</p>
        <p class="ph-about-points">
          <span>Al Ajban nursery · Warsan branch</span>
          <span>Landscape &amp; contractor supply</span>
          <span>ISO-certified quality &amp; safety</span>
        </p>
        <a class="ph-text-link" href="/about">About Pheladelfia <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

{% include "_certifications" %}

