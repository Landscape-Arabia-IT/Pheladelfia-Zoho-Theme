{% extends "_theme" %}
{% block content %}
<article class="ph-journal-post">
  <section class="ph-page-banner">
    <div class="ph-wrap">
      <nav aria-label="Breadcrumb" class="ph-crumbs">
        <a href="/">Home</a><span class="ph-crumb-sep">/</span><a href="/blog">Blog</a><span class="ph-crumb-sep">/</span><span aria-current="page">{{ blog_post.post_title }}</span>
      </nav>
      <p class="ph-kicker">Journal</p>
      <h1>{{ blog_post.post_title }}</h1>
      <span class="ph-rule"></span>
    </div>
  </section>
  <section class="ph-section">
    <div class="ph-wrap ph-journal-body">
      <div class="ph-copy">{{ blog_post.content }}</div>
    </div>
  </section>
</article>
{% endblock %}
