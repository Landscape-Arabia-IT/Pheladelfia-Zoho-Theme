<section class="ph-page-head">
  <div class="ph-wrap">
    <nav class="ph-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="ph-crumb-sep">/</span>
      <span aria-current="page">Search</span>
    </nav>
    <h1 class="ph-h2">{% if search.query %}Results for “{{ search.query }}”{% else %}Search results{% endif %}</h1>
  </div>
</section>
<section class="ph-store ph-catalog ph-search-results">
  <div class="ph-wrap">
    {% if no_products_message %}
      <p class="ph-lead" data-ph-initial-empty>{{ no_products_message }}</p>
      <p><a class="ph-btn" href="/all-collections">Explore collections</a></p>
    {% endif %}
    {% assign ph_sort_options = search.sort_by_options %}
    {% include "_catalog-tools" %}
    <div class="ph-catalog-layout">
      <aside class="ph-filter-panel" id="ph-catalog-filters" data-zs-filter-container>{% include "store-product-filters" %}</aside>
      <div class="ph-catalog-main">
    <div class="ph-product-grid" data-ph-product-grid data-sort-by-products-target>
      {% for product in search.products %}
        {% include "store-product-list-view" %}
      {% endfor %}
      {% include '_store-pagination' %}
    </div>
      </div>
    </div>
  </div>
</section>
