{% assign qv_variant_id = "" %}
{% assign qv_oos_all = false %}
{% if product.variants %}
  {% assign qv_open = false %}
  {% for variant in product.variants %}
    {% if variant.is_out_of_stock == false && variant.hide_add_to_cart == false && variant.is_available_for_purchase != false %}
      {% if qv_open == false %}{% assign qv_variant_id = variant.variant_id %}{% endif %}
      {% assign qv_open = true %}
    {% endif %}
  {% endfor %}
  {% if qv_open == false %}{% assign qv_oos_all = true %}{% endif %}
{% endif %}
{% if product.variants | size == 0 %}
  {% if product.is_out_of_stock %}{% assign qv_oos_all = true %}{% endif %}
{% endif %}
<div class="ph-qv" data-ph-qv data-zs-product-id="{{ product.product_id }}" data-zs-product-url="{{ product.url }}">
  <button type="button" class="ph-qv-close" data-ph-qv-close aria-label="Close quick view">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <div class="ph-qv-media">
    <div class="ph-qv-main" data-ph-qv-main>
      {% if product.images %}
        {% assign qvimg = product.images[0].url %}
        {% if product.images[0].is_placeholder_image == false %}{% assign qvimg = product.images[0].url + '/800x800' %}{% endif %}
        <img src="{{ qvimg }}" alt="{{ product.name }}">
      {% endif %}
    </div>
    {% if product.images | size > 1 %}
    <div class="ph-qv-thumbs" data-ph-qv-thumbs>
      {% for image in product.images %}
        {% assign qvt = image.url %}
        {% if image.is_placeholder_image == false %}{% assign qvt = image.url + '/200x200' %}{% endif %}
        {% assign qvfull = image.url %}
        {% if image.is_placeholder_image == false %}{% assign qvfull = image.url + '/800x800' %}{% endif %}
        <button type="button" class="ph-qv-thumb{% if forloop.first %} is-active{% endif %}" data-ph-qv-thumb="{{ qvfull }}">
          <img src="{{ qvt }}" alt="{{ product.name }}" loading="lazy">
        </button>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  <div class="ph-qv-info">
    <div class="ph-qv-head">
      {% if product.category_name %}<p class="ph-kicker">{{ product.category_name }}</p>{% endif %}
      <h3 class="ph-h3">{{ product.name }}</h3>
      <p class="ph-price ph-qv-price" data-ph-qv-price>
        {% if product.has_variant_price %}{{ currency.symbol }}{{ product.starts_with }} – {{ currency.symbol }}{{ product.ends_with }}{% else %}{{ currency.symbol }}{{ product.selling_price }}{% endif %}
      </p>
      <p class="ph-qv-vat">Exclusive of 5% VAT</p>
    </div>
    {% if product.short_description %}<div class="ph-lead ph-qv-desc">{{ product.short_description }}</div>{% endif %}
    {% if product.variants %}
    <div class="ph-variant-fields">
      <label class="ph-field-label" for="ph-qv-size-{{ product.product_id }}">Size</label>
      <select class="ph-select ph-qv-size" id="ph-qv-size-{{ product.product_id }}" data-ph-qv-size>
        {% for variant in product.variants %}
        {% assign qv_oos = false %}
        {% if variant.is_out_of_stock || variant.hide_add_to_cart || variant.is_available_for_purchase == false %}{% assign qv_oos = true %}{% endif %}
        <option value="{{ variant.variant_id }}" data-ph-qv-price="{{ variant.selling_price }}"{% if qv_oos %} disabled data-ph-qv-oos="1"{% endif %}>{% for option in variant.options %}{{ option.value }}{% if forloop.last == false %} · {% endif %}{% endfor %} — {{ currency.symbol }}{{ variant.selling_price }}{% if qv_oos %} — Out of stock{% endif %}</option>
        {% endfor %}
      </select>
    </div>
    {% endif %}
    <div class="ph-qv-actions">
      <button class="ph-btn ph-qv-add" type="button" data-ph-qv-add data-ph-qv-variant="{{ qv_variant_id }}"{% if qv_oos_all %} disabled{% endif %}>{% if qv_oos_all %}Out of stock{% else %}Add to cart{% endif %}</button>
      <a class="ph-btn ph-btn-outline" href="{{ product.url }}">Full details</a>
    </div>
    <p class="ph-buy-error" data-theme-error style="display:none;"></p>
    <p class="ph-qv-ship">Delivery across the UAE. The charge and the day are confirmed at checkout.</p>
    <div class="ph-qv-foot">
      {% if page.is_portal_enabled %}
      <button type="button" class="ph-wish-btn" data-zs-wishlist-element data-ph-auth-wishlist
        {% if qv_variant_id %}data-zs-wishlist-variant-id="{{ qv_variant_id }}"{% endif %}
        hidden aria-label="Save to wishlist" aria-pressed="false"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><span class="ph-wish-label">Save to wishlist</span></button>
      {% endif %}
    </div>
  </div>
</div>
