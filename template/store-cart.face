{% extends "_theme" %}
{% block content %}
<div class="phx-shell phx-cart">

<section class="phx-main">
  <header class="phx-title"><h1>Your cart</h1></header>
  {% assign ph_order_stage = "cart" %}
  {% include "_order-journey" %}
  {% assign ph_cart_count = cart.items | size %}
  {% if ph_cart_count > 0 %}
  <div class="phx-grid">
    <div class="phx-products"><div class="phx-panel-heading"><h2>Your plants</h2><span>{{ ph_cart_count }} {% if ph_cart_count == 1 %}<span>item</span>{% else %}<span>items</span>{% endif %}</span></div>
      <p class="phx-feedback" data-ph-cart-feedback role="status" aria-live="polite" hidden></p>
      <div data-cart-items>
      {% for item in cart.items %}
        <article class="phx-item" data-ph-cart-row data-ph-item-url="{{ item.url }}" data-zs-product-id="{{ item.product_id }}" data-zs-product-variant-id="{{ item.variant_id }}" data-zs-product-wrapper-lineitem-id="{{ item.line_item_id }}">
          <div class="phx-photo" data-ph-cart-photo></div>
          <div class="phx-item-info"><a href="{{ item.url }}">{{ item.name }}</a><p data-ph-cart-meta></p><span class="phx-unit"><span>Unit price</span> <strong data-ph-cart-unit></strong></span></div>
          <div class="phx-quantity"><button type="button" data-ph-qty-minus aria-label="Decrease quantity">−</button><input type="number" min="1" value="{{ item.quantity }}" data-zs-quantity aria-label="Quantity"><button type="button" data-ph-qty-plus aria-label="Increase quantity">+</button></div>
          <strong class="phx-item-total" data-ph-cart-total>{{ cart.symbol }} {{ item.total_price }}</strong>
          <div class="phx-item-actions"><button type="button" data-zs-delete data-ph-remove>Remove</button><button type="button" data-zs-save-for-later data-zs-product-variant-id="{{ item.variant_id }}" data-zs-product-lineitem-id="{{ item.line_item_id }}">Save for later</button></div>
        </article>
      {% endfor %}
      </div>
      <a class="phx-inline-link" href="/all-collections">Add more plants <span aria-hidden="true">→</span></a>
      {% include "_purchase-saved" %}
    </div>
    <aside class="phx-summary"><h2>Order summary</h2><div class="phx-summary-line phx-summary-subtotal"><span>Subtotal</span><strong data-ph-cart-subtotal>{{ cart.symbol }} {{ cart.sub_total }}</strong></div><div class="phx-summary-line"><span>VAT &amp; delivery</span><small>Calculated at checkout</small></div><p class="phx-summary-note">Prices exclude 5% VAT. Final charges are shown at checkout.</p>
    {% assign ph_ship_mode = "compact" %}
    {% include "_delivery-note" %}
    {% if cart.checkout_url %}<a class="phx-button" data-zs-checkout href="{{ cart.checkout_url }}"><span>Checkout</span></a>{% endif %}
    <p class="phx-summary-support">Need a hand with your order? <a href="{{ ph_phone_tel }}">Contact our team</a></p></aside>
  </div>
  {% else %}
  <div class="phx-empty"><span class="phx-empty-icon" aria-hidden="true">✳</span><h2>A little room for something green.</h2><p>Your cart is empty. Find a plant to make your space your own.</p><a class="phx-button" href="/all-collections">Explore our plants <span aria-hidden="true">→</span></a></div>
  {% endif %}
  {% if ph_cart_count == 0 %}{% include "_purchase-saved" %}{% endif %}
  <div data-save-for-later-alert-update="theme-save-for-later-alert-update" role="status" aria-live="polite"></div>
  <div data-zs-cross-sell-products></div>
</section>

</div>
{% endblock %}
