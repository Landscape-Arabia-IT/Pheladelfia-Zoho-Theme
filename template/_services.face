<!-- Page banner -->
<section class="ph-page-banner">
  <div class="ph-page-banner-media"><img src="{{ ph_img }}/palm-nursery-rows.jpg" alt="" aria-hidden="true"></div>
  <div class="ph-wrap">
    <nav aria-label="Breadcrumb" class="ph-crumbs">
      <a href="/">Home</a><span class="ph-crumb-sep">/</span><span aria-current="page">Services</span>
    </nav>
    <h1>Our Services</h1>
    <p class="ph-lead">From sourcing and quality control to logistics, import and export — we manage the full horticultural supply chain so you receive the right plants, in the right condition, on time.</p>
    <span class="ph-rule"></span>
  </div>
</section>

<section class="ph-section">
