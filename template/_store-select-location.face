{% if page.is_delivery_location_enabled %}
<a class="ph-icon-btn ph-delivery-link" data-zs-checkout-availablity href="javascript:;" aria-label="Delivery location">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
  <span data-zs-delivery-postalcode class="ph-sr-only">Select delivery location</span>
</a>
{% endif %}
