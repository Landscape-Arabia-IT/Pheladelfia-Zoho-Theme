<select hidden data-zs-variants>
  <option value="-1" data-zs-attributes="[]"></option>
  {% for variant in product.variants %}
  <option value="{{ variant.variant_id }}" data-ph-option-ids="{% for option in variant.options %}{{ option.id }} {% endfor %}" data-zs-attributes="[]">{{ variant.sku }}</option>
  {% endfor %}
</select>
{% if product.variants %}
<div class="ph-variant-fields">
  <label class="ph-field-label" for="ph-size-select">Size <span data-ph-size-label></span></label>
  <select class="ph-select ph-size-select" id="ph-size-select" data-ph-variant-pick aria-label="Size">
    <option value="">Select size</option>
    {% for variant in product.variants %}
    {% assign ph_v_oos = false %}
    {% if variant.is_out_of_stock || variant.hide_add_to_cart || variant.is_available_for_purchase == false %}{% assign ph_v_oos = true %}{% endif %}
    <option value="{{ variant.variant_id }}"{% if ph_v_oos %} disabled{% endif %}>{% for option in variant.options %}{{ option.value }}{% if forloop.last == false %} · {% endif %}{% endfor %}{% if ph_v_oos %} — unavailable{% endif %}</option>
    {% endfor %}
  </select>
  <p class="ph-ct-note">CT = clear trunk height, measured from soil level to the first branch.</p>
</div>
{% endif %}
{% if product.attributes %}
  {% for attribute in product.attributes %}
  <select class="ph-select ph-sr-only" data-zs-attribute-select data-zs-attribute-id="{{ attribute.id }}" aria-label="{{ attribute.name }}">
    <option value="">Select {{ attribute.name }}</option>
    {% for option in attribute.options %}
    <option value="{{ option.id }}">{{ option.value }}</option>
    {% endfor %}
  </select>
  {% endfor %}
{% endif %}
