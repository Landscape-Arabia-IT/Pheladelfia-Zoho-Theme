<article class="ph-product-card" data-ph-product-card data-ph-product-id="{{ product.product_id }}" data-ph-options="">   <a href="{{ product.url }}">     <div class="ph-product-photo" data-ph-gallery>{% include "_store-product-image" %}</div>     <div class="ph-card-body">       {% if product.category_name %}<p class="ph-kicker">{{ product.category_name }}</p>{% endif %}       <h3 class="ph-h3">{{ product.name }}</h3>       {% if product.short_description %}<p class="ph-copy">{{ product.short_description }}</p>{% endif %}       {% include "_store-product-pricing" %}       <span class="ph-more">View specimen</span>     </div>   </a>   <span hidden data-ph-option-source>{% for attribute in product.attributes %}{% for option in attribute.options %}{{ option.id }} {% endfor %}{% endfor %}</span>
   <button type="button" class="ph-qv-btn" data-zs-quick-view data-zs-product-url="{{ product.url }}" aria-label="Quick view"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="2.6"/></svg></button>
   {% if page.is_portal_enabled %}<button type="button" class="ph-wish-btn" data-zs-wishlist-element data-ph-auth-wishlist data-ph-wish-btn{% if product.variants %}{% for variant in product.variants %}{% if forloop.first %} data-zs-wishlist-variant-id="{{ variant.variant_id }}"{% endif %}{% endfor %}{% endif %} hidden aria-label="Save to wishlist" aria-pressed="false"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.3-9C1.2 8.6 3 5 6.6 5c2 0 3.6 1.1 4.4 2.6C11.8 6.1 13.4 5 15.4 5 19 5 20.8 8.6 19.3 12c-1.8 4.4-7.3 9-7.3 9z"/></svg></button>{% endif %}
 </article> 