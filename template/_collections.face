  <div class="ph-wrap">
    <nav aria-label="Breadcrumb" class="ph-crumbs">
      <a href="/">Home</a><span class="ph-crumb-sep">/</span><span aria-current="page">Collections</span>
    </nav>
    <h1>All collections</h1>
    <p class="ph-lead">Every category in the Pheladelfia online store, from palms and specimen trees to indoor plants, garden supply and art. Open a collection to see its species and sized specimens.</p>
    <span class="ph-rule"></span>
  </div>
</section>

