<!-- ===== Hero slider ===== -->
<section class="ph-hero ph-hero-slider" id="top" data-ph-slider aria-roledescription="carousel" aria-label="Featured">
  <h1 class="ph-sr-only">Premium palms, trees and specimen plants — Pheladelfia Agricultural LLC, Abu Dhabi since 2004</h1>
  <div class="ph-hero-slides">
    <div class="ph-hero-slide is-active" role="group" aria-roledescription="slide" aria-label="1 of 4">
      <div class="ph-hero-media"><img src="{{ ph_img }}/palm-nursery-rows.jpg" alt="Rows of mature Washingtonia palms at the Pheladelfia nursery in Abu Dhabi" width="1000" height="666" fetchpriority="high"></div>
      <div class="ph-hero-overlay" aria-hidden="true"></div>
      <div class="ph-wrap">
        <div class="ph-hero-copy">
          <span class="ph-eyebrow ph-anim ph-anim-1">Abu Dhabi nursery · Est. 2004</span>
          <h2 class="ph-hero-title ph-anim ph-anim-2">Specimen Palms &amp; Washingtonia</h2>
          <p class="ph-hero-lead ph-anim ph-anim-3">Fan, date and specimen palms — selected, acclimatized and delivered ready to plant across the Emirates.</p>
          <div class="ph-hero-actions ph-anim ph-anim-4">
            <a class="ph-btn ph-btn-gold" href="{{ ph_url_palm_trees }}">Browse palms <span aria-hidden="true">→</span></a>
            <a class="ph-btn ph-btn-ghost" href="/all-collections">Shop plants</a>
          </div>
        </div>
      </div>
    </div>
    <div class="ph-hero-slide" role="group" aria-roledescription="slide" aria-label="2 of 4">
      <div class="ph-hero-media"><img src="{{ ph_img }}/palm-grove-fan.jpg" alt="Fan palms at the Pheladelfia nursery" width="1000" height="666" loading="lazy"></div>
      <div class="ph-hero-overlay" aria-hidden="true"></div>
      <div class="ph-wrap">
        <div class="ph-hero-copy">
          <span class="ph-eyebrow ph-anim ph-anim-1">Documented provenance</span>
          <h2 class="ph-hero-title ph-anim ph-anim-2">Every Specimen, Documented</h2>
          <p class="ph-hero-lead ph-anim ph-anim-3">Photographed at three angles with scale reference, measured and recorded — documentation provided on request.</p>
          <div class="ph-hero-actions ph-anim ph-anim-4">
            <a class="ph-btn ph-btn-gold" href="/services">How we work <span aria-hidden="true">→</span></a>
            <a class="ph-btn ph-btn-ghost" href="/contact">Get in touch</a>
          </div>
        </div>
      </div>
    </div>
    <div class="ph-hero-slide" role="group" aria-roledescription="slide" aria-label="3 of 4">
      <div class="ph-hero-media"><img src="{{ ph_img }}/mediterranean_nursery_ancient_olive_trees.jpeg" alt="Ancient olive trees in a Mediterranean nursery" loading="lazy"></div>
      <div class="ph-hero-overlay" aria-hidden="true"></div>
      <div class="ph-wrap">
        <div class="ph-hero-copy">
          <span class="ph-eyebrow ph-anim ph-anim-1">Rare &amp; ancient trees</span>
          <h2 class="ph-hero-title ph-anim ph-anim-2">Rare &amp; Ancient Specimens</h2>
          <p class="ph-hero-lead ph-anim ph-anim-3">Heritage and monumental trees with documented provenance, sourced across the Mediterranean, GCC and Asia.</p>
          <div class="ph-hero-actions ph-anim ph-anim-4">
            <a class="ph-btn ph-btn-gold" href="{{ ph_url_rare_trees }}">Explore rare trees <span aria-hidden="true">→</span></a>
            <a class="ph-btn ph-btn-ghost" href="/contact">Request availability</a>
          </div>
        </div>
      </div>
    </div>
    <div class="ph-hero-slide" role="group" aria-roledescription="slide" aria-label="4 of 4">
      <div class="ph-hero-media"><img src="{{ ph_img }}/cacti-succulents.jpeg" alt="Giant cacti and succulents at the Pheladelfia nursery" width="800" height="600" loading="lazy"></div>
      <div class="ph-hero-overlay" aria-hidden="true"></div>
      <div class="ph-wrap">
        <div class="ph-hero-copy">
          <span class="ph-eyebrow ph-anim ph-anim-1">Desert specimens</span>
          <h2 class="ph-hero-title ph-anim ph-anim-2">Giant Cacti &amp; Yucca Rostrata</h2>
          <p class="ph-hero-lead ph-anim ph-anim-3">Statement desert specimens — columnar cacti, barrel cacti and architectural succulents, grown and delivered across the Emirates.</p>
          <div class="ph-hero-actions ph-anim ph-anim-4">
            <a class="ph-btn ph-btn-gold" href="{{ ph_url_cacti }}">Explore cacti <span aria-hidden="true">→</span></a>
            <a class="ph-btn ph-btn-ghost" href="/contact">Request availability</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="ph-hero-controls">
    <div class="ph-hero-dots" data-ph-dots role="group" aria-label="Slide navigation"></div>
  </div>
  <p class="ph-sr-only" data-ph-slide-status aria-live="polite"></p>
</section>

<!-- ===== Trust bar ===== -->
<section class="ph-trustbar">
  <div class="ph-wrap">
    <ul class="ph-trust-grid">
      <li class="ph-trust-item">
        <span class="ph-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span>
        <span><span class="ph-trust-label">Since 2004</span><span class="ph-trust-sub">Two decades of growing</span></span>
      </li>
      <li class="ph-trust-item">
        <span class="ph-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg></span>
        <span><span class="ph-trust-label">UAE-adapted plants</span><span class="ph-trust-sub">Acclimatized in Abu Dhabi</span></span>
      </li>
      <li class="ph-trust-item">
        <span class="ph-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg></span>
        <span><span class="ph-trust-label">Delivery across the UAE</span><span class="ph-trust-sub">All seven Emirates</span></span>
      </li>
      <li class="ph-trust-item">
        <span class="ph-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 4 7v5c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7z"/></svg></span>
        <span><span class="ph-trust-label">Project supply</span><span class="ph-trust-sub">Sourcing to delivery</span></span>
      </li>
    </ul>
  </div>
</section>

<!-- ===== Categories ===== -->
<section class="ph-section">
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-center">
      <span class="ph-eyebrow">Shop by category</span>
      <h2 class="ph-sec-title">Everything for design-led planting</h2>
      <p class="ph-sec-sub">Browse our nursery by plant type — every item grown or selected for the UAE climate.</p>
    </div>
    <div class="ph-cat-grid">
      <a class="ph-cat-card" href="{{ ph_url_palm_trees }}">
        <img src="{{ ph_img }}/palm-grove-fan.jpg" alt="Fan palms at the Pheladelfia nursery" width="800" height="600" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Fan, date &amp; specimen palms</span>
          <span class="ph-cat-name">Palms <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_trees }}">
        <img src="{{ ph_img }}/ghaf-tree.jpg" alt="Native Ghaf tree" width="800" height="600" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Shade &amp; native trees</span>
          <span class="ph-cat-name">Trees <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_rare_trees }}">
        <img src="{{ ph_img }}/phoenix-canariensis.jpg" alt="Specimen palm tree" width="800" height="600" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Heritage &amp; monumental specimens</span>
          <span class="ph-cat-name">Rare &amp; Ancient Trees <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_cacti }}">
        <!-- TODO: publish cacti-succulents.jpeg in the Zoho media library; the card hides itself until then -->
        <img src="{{ ph_img }}/cacti-succulents.jpeg" alt="Giant cacti and succulents at the Pheladelfia nursery" width="800" height="600" loading="lazy" onerror="this.closest('a').style.display='none'">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Giant cacti, succulents &amp; Yucca rostrata</span>
          <span class="ph-cat-name">Cacti &amp; Succulents <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_shrubs }}">
        <img src="{{ ph_img }}/bougainvillea.jpg" alt="Flowering bougainvillea shrub" width="800" height="600" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Flowering shrubs &amp; ground covers</span>
          <span class="ph-cat-name">Shrubs &amp; Ground Cover <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_indoor }}">
        <img src="{{ ph_img }}/indoor-plants.jpg" alt="Indoor ornamental plants" width="800" height="600" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">For homes, offices &amp; hotels</span>
          <span class="ph-cat-name">Indoor Plants <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
      <a class="ph-cat-card" href="{{ ph_url_fertilizers }}">
        <img src="{{ ph_img }}/planters.jpg" alt="Plant pots and garden supplies" width="800" height="600" loading="lazy">
        <span class="ph-cat-body">
          <span class="ph-cat-blurb">Planters, soil &amp; care</span>
          <span class="ph-cat-name">Pots &amp; Supplies <span class="ph-cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </span>
      </a>
    </div>
  </div>
</section>

<!-- Catalog cards are rendered by the category FACE layout and loaded progressively. -->
<section class="ph-section ph-section-sand" data-ph-best-section>
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-row">
      <div class="ph-sec-head-text">
        <span class="ph-eyebrow">From our nursery</span>
        <h2 class="ph-sec-title">Explore our plants</h2>
      </div>
      <div class="ph-carousel-nav">
        <button class="ph-carousel-btn" type="button" data-ph-carousel-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg></button>
        <button class="ph-carousel-btn" type="button" data-ph-carousel-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
    </div>
    <div class="ph-carousel" data-ph-best-sellers aria-busy="true"></div>
    <p class="ph-copy" data-ph-catalog-status><span data-ph-catalog-loading>Loading plants…</span> <a href="/all-collections">Browse collections</a></p>
  </div>
</section>

<!-- ===== Why us ===== -->
<section class="ph-why ph-section">
  <div class="ph-wrap">
    <div class="ph-why-grid">
      <div class="ph-gold-frame">
        <img src="{{ ph_img }}/palm-single-specimen.jpg" alt="A specimen fan palm at our nursery" width="800" height="1000" loading="lazy">
      </div>
      <div>
        <span class="ph-eyebrow">Why Pheladelfia</span>
        <h2 class="ph-why-title">Rooted in the Emirates for over 20 years</h2>
        <div class="ph-why-items">
          <div class="ph-why-item">
            <span class="ph-why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="18" height="13" rx="2"/><circle cx="12" cy="13.5" r="3.5"/><path d="M8.5 7 10 4.5h4L15.5 7"/></svg></span>
            <h3>Documented provenance</h3>
            <p>Every specimen is recorded, measured, and supported by a professional photography pack — three angles, scale reference, high-resolution — provided on request.</p>
          </div>
          <div class="ph-why-item">
            <span class="ph-why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21c-4-3-7-6-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4-3 7-7 10z"/></svg></span>
            <h3>Transplanting protocol</h3>
            <p>Large specimens are relocated under documented transplanting protocols, with monitored establishment and aftercare support.</p>
          </div>
          <div class="ph-why-item">
            <span class="ph-why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.5 2.7-6 6-6s6 2.5 6 6"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14.5c3 .3 5.5 2.6 5.5 5.5"/></svg></span>
            <h3>Built for designers</h3>
            <p>Site visits, sample photography, and specification-ready documentation for landscape architects and design-led contractors.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== Process ===== -->
<section class="ph-section ph-section-sand">
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-center">
      <span class="ph-eyebrow">How we work</span>
      <h2 class="ph-sec-title">From enquiry to established planting</h2>
    </div>
    <div class="ph-steps ph-steps-5">
      <div>
        <div class="ph-step-num">01</div>
        <h3>Enquiry &amp; requirements</h3>
        <p>Share your plant list, sizes, and quantities. We review them against our nursery stock and sourcing network.</p>
      </div>
      <div>
        <div class="ph-step-num">02</div>
        <h3>Sourcing &amp; availability</h3>
        <p>Our field team checks prices and availability — drawing on our own farm and trusted nurseries at origin.</p>
      </div>
      <div>
        <div class="ph-step-num">03</div>
        <h3>Quality control</h3>
        <p>Every plant is inspected before delivery, then transported so it arrives on time and in the expected condition.</p>
      </div>
      <div>
        <div class="ph-step-num">04</div>
        <h3>Logistics</h3>
        <p>Plants delivered on time and in the condition expected — because receiving them when you need them is critical to your project schedule.</p>
      </div>
      <div>
        <div class="ph-step-num">05</div>
        <h3>Delivery &amp; support</h3>
        <p>Delivery across the Emirates and wider Gulf, with aftercare support through establishment.</p>
      </div>
    </div>
  </div>
</section>

{% include "_certifications" %}

