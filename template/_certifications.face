<!-- Certifications -->
<section class="ph-section ph-certs" id="certifications">
  <div class="ph-dots-bg"></div>
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-center ph-reveal">
      <span class="ph-eyebrow">Certified excellence</span>
      <h2 class="ph-sec-title">Quality, environment and safety you can verify</h2>
      <span class="ph-hairline"></span>
      <p class="ph-sec-sub">Pheladelfia operates to internationally recognised management standards, certified by Bureau Veritas under EIAC accreditation.</p>
    </div>
    <div class="ph-cert-grid ph-stagger">
      <article class="ph-cert-card">
        <a class="ph-cert-thumb" href="{{ ph_img }}/cert-iso-9001-full.jpg" target="_blank" rel="noopener" aria-label="View certificate">
          <img src="{{ ph_img }}/cert-iso-9001.jpg" alt="ISO 9001:2015 certificate" loading="lazy">
        </a>
        <span class="ph-cert-seal" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 12.5l5 5L20 6.5"/></svg></span>
        <h3 data-ph-no-translate>ISO 9001:2015</h3>
        <p class="ph-cert-name">Quality Management System</p>
        <p class="ph-cert-meta"><span>Certified by</span> <span>Bureau Veritas · EIAC-accredited</span></p>
      </article>
      <article class="ph-cert-card">
        <a class="ph-cert-thumb" href="{{ ph_img }}/cert-iso-14001-full.jpg" target="_blank" rel="noopener" aria-label="View certificate">
          <img src="{{ ph_img }}/cert-iso-14001.jpg" alt="ISO 14001:2015 certificate" loading="lazy">
        </a>
        <span class="ph-cert-seal" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 12.5l5 5L20 6.5"/></svg></span>
        <h3 data-ph-no-translate>ISO 14001:2015</h3>
        <p class="ph-cert-name">Environmental Management System</p>
        <p class="ph-cert-meta"><span>Certified by</span> <span>Bureau Veritas · EIAC-accredited</span></p>
      </article>
      <article class="ph-cert-card">
        <a class="ph-cert-thumb" href="{{ ph_img }}/cert-iso-45001-full.jpg" target="_blank" rel="noopener" aria-label="View certificate">
          <img src="{{ ph_img }}/cert-iso-45001.jpg" alt="ISO 45001:2018 certificate" loading="lazy">
        </a>
        <span class="ph-cert-seal" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 12.5l5 5L20 6.5"/></svg></span>
        <h3 data-ph-no-translate>ISO 45001:2018</h3>
        <p class="ph-cert-name">Occupational Health &amp; Safety Management System</p>
        <p class="ph-cert-meta"><span>Certified by</span> <span>Bureau Veritas · EIAC-accredited</span></p>
      </article>
    </div>

    <p class="ph-cert-note">Certified by Bureau Veritas under EIAC accreditation · Licences &amp; registrations include Abu Dhabi trade licence CN-1078760, agriculture licence AGL-2021-15516, commercial registration 6091168, Abu Dhabi Chamber member 208354, and Federal VAT &amp; corporate tax registration.</p>
  </div>
</section>
