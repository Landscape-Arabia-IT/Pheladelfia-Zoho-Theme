{% extends "_theme" %}
{% block content %}
<div class="phx-shell phx-result">
{% include "_purchase-header" %}
<section class="phx-main">
  <div class="phx-receipt {% if payment_status.order_placed %}is-success{% else %}is-error{% endif %}">
  {% if payment_status.order_placed %}
    <div class="phx-result-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m5 12 4 4L19 6"/></svg></div>
    <p class="phx-eyebrow">ORDER RECEIVED</p><h1>Thank you.</h1><p>Your order has been received. Keep your order reference for any enquiries.</p>
  {% else %}
    <div class="phx-result-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M12 7v6m0 3v1"/></svg></div>
    <p class="phx-eyebrow">LET’S GET THIS SORTED</p><h1>Payment needs attention</h1><p>We could not confirm this payment. If you see a charge, contact our team with your order reference before trying again.</p>
  {% endif %}
  <dl class="phx-receipt-details">
    {% if payment_status.salesorder_number %}<div><dt>Order reference</dt><dd>{{ payment_status.salesorder_number }}</dd></div>{% endif %}
    {% if payment_status.amount_formatted %}<div><dt>Order amount</dt><dd>{{ payment_status.amount_formatted }}</dd></div>{% endif %}
    {% if payment_status.payment_mode %}<div><dt>Payment method</dt><dd>{{ payment_status.payment_mode }}</dd></div>{% endif %}
    {% if payment_status.transaction_status %}<div><dt>Status</dt><dd>{{ payment_status.transaction_status }}</dd></div>{% endif %}
    {% if payment_status.customer_email %}<div><dt>Email</dt><dd>{{ payment_status.customer_email }}</dd></div>{% endif %}
  </dl>
  {% if payment_status.order_placed %}
    {% for order in payment_status.order_info %}
    <div class="phx-receipt-order"><h2>Order summary</h2>
    {% for item in order.line_items %}<div class="phx-summary-line"><span>{{ item.name }} <small>× {{ item.quantity }}</small></span><strong>{{ currency.symbol }} {{ item.rate }}</strong></div>{% endfor %}
    {% if order.sub_total %}<div class="phx-summary-line"><span>Subtotal</span><strong>{{ currency.symbol }} {{ order.sub_total }}</strong></div>{% endif %}
    {% if order.shipping_charge %}<div class="phx-summary-line"><span>Delivery</span><strong>{{ currency.symbol }} {{ order.shipping_charge }}</strong></div>{% endif %}
    {% if order.tax_total %}<div class="phx-summary-line"><span>VAT</span><strong>{{ currency.symbol }} {{ order.tax_total }}</strong></div>{% endif %}
    </div>{% endfor %}
    <a class="phx-button" href="/all-collections">Continue shopping <span aria-hidden="true">→</span></a>
    {% if page.is_portal_enabled %}<a class="phx-inline-link" href="/account/orders">View my orders</a>{% endif %}
  {% else %}
    {% if payment_status.error %}<p class="phx-error" role="alert">{{ payment_status.error }}</p>{% endif %}
    <a class="phx-button" href="/cart">Back to cart <span aria-hidden="true">→</span></a>
    <a class="phx-inline-link" href="mailto:{{ ph_email }}">Contact our team</a>
  {% endif %}
  </div>
</section>
{% include "_purchase-footer" %}
</div>
{% endblock %}
