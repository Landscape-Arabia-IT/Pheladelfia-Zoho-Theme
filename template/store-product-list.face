{% comment %}Zoho /api/product-list supplies products, not a single product. Keep this entry point compatible with the official FACE base theme.{% endcomment %}
{% for product in products %}
  {% include "store-product-list-view" %}
{% forelse %}
  <div class="ph-catalog-empty" role="status"><p>No products match your filters.</p></div>
{% endfor %}
{% include "_store-pagination" %}
