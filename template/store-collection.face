{% extends "_theme" %}
{% block content %}
<section class="ph-page-banner ph-catalog-banner">
  <div class="ph-wrap">
    <nav class="ph-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="ph-crumb-sep">/</span>
      <a href="/all-collections">All collections</a>
      <span class="ph-crumb-sep">/</span>
      <span aria-current="page">{{ collection.name }}</span>
    </nav>
    <p class="ph-kicker">Collection</p>
    <h1>{{ collection.name }}</h1>
    {% if collection.description %}<div class="ph-lead">{{ collection.description }}</div>{% endif %}
    <span class="ph-rule"></span>
  </div>
</section>
<section class="ph-store ph-catalog">
  <div class="ph-wrap ph-catalog-layout">
    <div class="ph-catalog-main">
      <div class="ph-product-grid" data-ph-product-grid data-sort-by-products-target>
        {% for product in collection.products %}
        {% include "store-product-list" %}
        {% endfor %}
      </div>
      {% include '_store-pagination' %}
      {% if no_products_message %}
      <p class="ph-lead">{{ no_products_message }}</p>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}
