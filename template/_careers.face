<!-- Page banner -->
<section class="ph-page-banner">
  <div class="ph-page-banner-media"><img src="{{ ph_img }}/palm-nursery-rows.jpg" alt="" aria-hidden="true"></div>
  <div class="ph-wrap">
    <nav aria-label="Breadcrumb" class="ph-crumbs">
      <a href="/">Home</a><span class="ph-crumb-sep">/</span><span aria-current="page">Join Us</span>
    </nav>
    <h1>Join Us</h1>
    <p class="ph-lead">Grow your career with an ISO-certified nursery and horticulture team in Abu Dhabi.</p>
    <span class="ph-rule"></span>
  </div>
</section>

<section class="ph-section">
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-center">
      <span class="ph-eyebrow">Careers</span>
      <h2 class="ph-sec-title">Build a career in horticulture</h2>
      <p class="ph-sec-sub">Since 2004, Pheladelfia has grown palms, trees and plants in Al Ajban, Abu Dhabi. Join a team that values safety, quality and care for the environment.</p>
    </div>
    <div class="ph-feature-grid">
      <div class="ph-feature"><h3>Safe workplace</h3><p>Our occupational health and safety system is certified to ISO 45001:2018.</p></div>
      <div class="ph-feature"><h3>Hands-on experience</h3><p>Work with palms, rare trees and large-scale projects across the UAE.</p></div>
      <div class="ph-feature"><h3>Quality &amp; environment</h3><p>Certified to ISO 9001 and ISO 14001, so good practice is part of every task.</p></div>
    </div>
  </div>
</section>

<section class="ph-section" style="padding-block-start:0;">
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-center">
      <span class="ph-eyebrow">Where you could fit</span>
      <h2 class="ph-sec-title">Our teams</h2>
    </div>
    <div class="ph-feature-grid">
      <div class="ph-feature"><h3>Nursery &amp; Horticulture</h3><p>Propagation, growing, irrigation and plant care at the nursery.</p></div>
      <div class="ph-feature"><h3>Plant Sourcing &amp; Trading</h3><p>Selecting specimens and coordinating supply across the Gulf.</p></div>
      <div class="ph-feature"><h3>Sales &amp; Customer Service</h3><p>Helping developers, consultants and contractors choose the right plants.</p></div>
      <div class="ph-feature"><h3>Logistics, Import &amp; Export</h3><p>Transport, quality control, documentation and project coordination.</p></div>
      <div class="ph-feature"><h3>Administration &amp; Accounts</h3><p>Office, procurement and finance support for a growing business.</p></div>
    </div>
  </div>
</section>

<!-- Open positions -->
<section class="ph-section" style="padding-block-start:0;">
  <div class="ph-wrap">
    <div class="ph-sec-head ph-sec-head-center">
      <span class="ph-eyebrow">Open positions</span>
      <h2 class="ph-sec-title">Current openings</h2>
      <p class="ph-sec-sub">Looking for a hands-on role in a certified horticulture nursery? Browse our open positions below.</p>
    </div>
    <div class="ph-jobs-tools">
      <input class="ph-jobs-search" type="search" data-ph-jobs-search placeholder="Search jobs by title, location or team…" aria-label="Search open positions">
    </div>
    <div class="ph-jobs-grid" data-ph-jobs-list></div>
    <div class="ph-job-detail" data-ph-job-detail hidden></div>
    <p class="ph-jobs-empty" data-ph-jobs-empty hidden>No positions match your search — send us your application anyway and we will keep your profile on file.</p>
    <p class="ph-copy" style="text-align:center; margin-block-start:1.5rem;">Don't see your role? <a class="ph-text-link" href="#apply">Apply anyway</a> — we keep promising profiles on file for future openings.</p>
    {% include "_jobs-data" %}
  </div>
</section>

<section class="ph-section" style="padding-block-start:0;" id="apply">
  <div class="ph-wrap">
    <div class="ph-contact-grid">
      <form data-ph-mail-form data-ph-form-type="careers" data-ph-endpoint="https://pheladelfia.com/forms/contact.php" enctype="multipart/form-data">
        <input type="text" name="website" tabindex="-1" autocomplete="off" hidden aria-hidden="true">
        <div class="ph-form-card">
          <h3>Apply now</h3>
          <p class="ph-copy" style="margin-block-end:1.2rem;">Send us your details. We review every application and keep promising profiles on file for future openings.</p>
          <div class="ph-form-stack">
            <div class="ph-field"><label for="ph-j-name">Full name</label><input id="ph-j-name" name="Name" required></div>
            <div class="ph-field"><label for="ph-j-phone">Phone</label><input id="ph-j-phone" name="Phone" type="tel" dir="ltr" required></div>
            <div class="ph-field"><label for="ph-j-email">Email</label><input id="ph-j-email" name="Email" type="email" required></div>
            <div class="ph-field">
              <label for="ph-j-area">Area of interest</label>
              <select id="ph-j-area" name="Area">
                <option>Nursery &amp; Horticulture</option>
                <option>Plant Sourcing &amp; Trading</option>
                <option>Sales &amp; Customer Service</option>
                <option>Logistics, Import &amp; Export</option>
                <option>Administration &amp; Accounts</option>
                <option>Other</option>
              </select>
            </div>
            <div class="ph-field"><label for="ph-j-position">Position</label><input id="ph-j-position" name="Position" placeholder="e.g. Supply Coordinator" autocomplete="off"></div>
            <div class="ph-field">
              <label for="ph-j-exp">Years of experience</label>
              <select id="ph-j-exp" name="Years of experience">
                <option value="">Select</option>
                <option>Less than 1 year</option>
                <option>1–2 years</option>
                <option>3–5 years</option>
                <option>5–10 years</option>
                <option>10+ years</option>
              </select>
            </div>
            <div class="ph-field">
              <label for="ph-j-visa">UAE residence visa?</label>
              <select id="ph-j-visa" name="Visa" data-ph-visa-toggle>
                <option value="">Select</option>
                <option>Yes</option>
                <option>No</option>
              </select>
            </div>
            <div class="ph-field" data-ph-visa-type-field hidden>
              <label for="ph-j-visatype">Visa type</label>
              <select id="ph-j-visatype" name="Visa type">
                <option value="">Select</option>
                <option>Employment visa</option>
                <option>Investor visa</option>
                <option>Family sponsorship</option>
                <option>Golden visa</option>
                <option>Other</option>
              </select>
            </div>
            <div class="ph-field">
              <label for="ph-j-licence">UAE driving licence?</label>
              <select id="ph-j-licence" name="Driving licence">
                <option value="">Select</option>
                <option>Yes</option>
                <option>No</option>
              </select>
            </div>
            <div class="ph-field"><label for="ph-j-cursal">Current salary</label><input id="ph-j-cursal" name="Current salary" placeholder="e.g. AED 5,000" autocomplete="off"></div>
            <div class="ph-field"><label for="ph-j-expsal">Expected salary</label><input id="ph-j-expsal" name="Expected salary" placeholder="e.g. AED 7,000" autocomplete="off"></div>
            <div class="ph-field ph-span-2"><label for="ph-j-msg">About you</label><textarea id="ph-j-msg" name="About" rows="5" required></textarea></div>
            <div class="ph-field ph-span-2"><label for="ph-j-cv">Attach your CV</label><input id="ph-j-cv" name="attachment" type="file" accept=".pdf,.doc,.docx" required><p class="ph-copy" style="font-size:0.82rem; margin:0.4rem 0 0;">PDF, DOC or DOCX — up to 10MB.</p></div>
          </div>
          <button class="ph-btn" type="submit">Submit application</button>
          <p class="ph-copy ph-form-done" hidden style="font-weight:600; color:var(--forest); margin-block:0.9rem 0 0;">Thank you! Your application was sent — our team will review it and contact you.</p>
          <p class="ph-copy ph-form-error" hidden style="font-weight:600; color:#b3261e; margin-block:0.9rem 0 0;">Couldn't send right now — please try again or email us at {{ ph_email }}.</p>
        </div>
      </form>
      <aside class="ph-contact-cards">
        <div class="ph-contact-card">
          <span class="ph-contact-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
          <div><p class="ph-field-label">Prefer email?</p><a href="mailto:{{ ph_email_jobs }}">{{ ph_email }}</a></div>
        </div>
        <div class="ph-contact-card">
          <span class="ph-contact-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
          <div><p class="ph-field-label">Based at</p><p>{{ ph_address_nursery }}</p></div>
        </div>
        <a class="ph-btn" href="{{ ph_whatsapp_url }}" target="_blank" rel="noopener" style="width:100%; background:var(--wa);">Chat on WhatsApp</a>
      </aside>
    </div>
  </div>
</section>
