<!-- Page banner -->
<section class="ph-page-banner">
  <div class="ph-wrap">
    <nav aria-label="Breadcrumb" class="ph-crumbs">
      <a href="/">Home</a><span class="ph-crumb-sep">/</span><span aria-current="page">Contact</span>
    </nav>
    <h1>Contact us</h1>
    <p class="ph-lead">Questions about a plant, an order or a project supply? We're happy to help.</p>
    <span class="ph-rule"></span>
  </div>
</section>

<section class="ph-section">
  <div class="ph-wrap">
    <div class="ph-contact-grid">
      <form data-ph-mail-form data-ph-form-type="contact" data-ph-endpoint="https://pheladelfia.com/forms/contact.php" enctype="multipart/form-data">
        <input type="text" name="website" tabindex="-1" autocomplete="off" hidden aria-hidden="true">
        <div class="ph-form-card">
          <h3>Send us a message</h3>
          <p class="ph-copy" style="margin-block-end:1.2rem;">Your message is sent securely to {{ ph_email }}.</p>
          <div class="ph-form-grid">
            <div class="ph-field"><label for="ph-name">Full name</label><input id="ph-name" name="Name" required></div>
            <div class="ph-field"><label for="ph-phone">Phone</label><input id="ph-phone" name="Phone" type="tel" dir="ltr"></div>
            <div class="ph-field"><label for="ph-email">Email</label><input id="ph-email" name="Email" type="email" required></div>
            <div class="ph-field">
              <label for="ph-type">Subject</label>
              <select id="ph-type" name="Subject">
                <option>Plant enquiry</option>
                <option>Specimen or project supply</option>
                <option>Existing order</option>
                <option>Import / export</option>
                <option>Other</option>
              </select>
            </div>
            <div class="ph-field ph-span-2"><label for="ph-message">Message</label><textarea id="ph-message" name="Message" rows="5" required></textarea></div>
          </div>
          <button class="ph-btn" type="submit">Send message</button>
          <p class="ph-copy ph-form-done" hidden style="font-weight:600; color:var(--forest); margin-block:0.9rem 0 0;">Thank you! Your message was sent — we'll get back to you soon.</p>
          <p class="ph-copy ph-form-error" hidden style="font-weight:600; color:#b3261e; margin-block:0.9rem 0 0;">Couldn't send right now — please try again or email us at {{ ph_email }}.</p>
        </div>
      </form>
      <aside class="ph-contact-cards">
        <div class="ph-contact-card">
          <span class="ph-contact-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></span>
          <div><p class="ph-field-label">Call us</p><a href="{{ ph_phone_tel }}" dir="ltr">{{ ph_phone_display }}</a><br><a href="{{ ph_phone_alt_tel }}" dir="ltr">{{ ph_phone_alt_display }}</a></div>
        </div>
        <div class="ph-contact-card">
          <span class="ph-contact-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
          <div><p class="ph-field-label">Email</p><a href="mailto:{{ ph_email }}">{{ ph_email }}</a><br><a href="mailto:{{ ph_email_info }}">{{ ph_email_info }}</a></div>
        </div>
        <div class="ph-contact-card">
          <span class="ph-contact-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></span>
          <div><p class="ph-field-label">Opening hours</p><p>{{ ph_hours }}</p></div>
        </div>
        <div class="ph-contact-card">
          <span class="ph-contact-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
          <div><p class="ph-field-label">Locations</p><p>{{ ph_address_nursery_short }}<br>{{ ph_address_branch }}</p></div>
        </div>
        <a class="ph-btn" href="{{ ph_whatsapp_url }}" target="_blank" rel="noopener" style="width:100%; background:var(--wa);">Chat on WhatsApp</a>
      </aside>
    </div>
  </div>
</section>

<section class="ph-section" style="padding-block-start:0;">
  <div class="ph-wrap">
    <div class="ph-map-block">
      <div class="ph-map-info">
        <span class="ph-map-pin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
        <p style="margin-block-start:1rem; font-family:var(--font-display); font-size:1.3rem; color:var(--forest);">{{ ph_address_nursery_short }}</p>
        <p class="ph-copy" style="font-size:0.9rem;">{{ ph_address_nursery }}</p>
        <a class="ph-btn ph-btn-outline" style="margin-block-start:1rem;" href="{{ ph_maps_url }}" target="_blank" rel="noopener">Open in Google Maps</a>
        <a class="ph-text-link" href="/visit">Visit the nursery</a>
      </div>
      <iframe class="ph-map-frame" src="https://www.google.com/maps?q=Pheladelfia+Agricultural+Al+Ajban+Abu+Dhabi&z=13&output=embed" title="Pheladelfia Agricultural LLC — Al Ajban, Abu Dhabi" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </div>
</section>
