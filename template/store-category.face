{% extends "_theme" %}
{% block content %}
<section class="ph-page-head">
  <div class="ph-wrap">
    <nav class="ph-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="ph-crumb-sep">/</span>
      <span aria-current="page">{{ category.name }}</span>
    </nav>
    <h1 class="ph-h2">{{ category.name }}</h1>
    {% if category.description %}<div class="ph-lead">{{ category.description }}</div>{% endif %}
  </div>
</section>
<section class="ph-store">
  <div class="ph-wrap">
    {% if category.sub_categories %}
    <div class="ph-cat-group" data-ph-subcats>
      <p class="ph-kicker">Species and sub-collections</p>
      <div class="ph-product-grid ph-category-grid" data-ph-subcat-grid>
        {% for sub in category.sub_categories %}
        <a class="ph-product-card" href="{{ sub.url }}" data-ph-cat-id="{{ sub.category_id }}">
          <div class="ph-card-photo" data-ph-cat-photo="{{ sub.category_id }}">
            {% for image in sub.images %}
              {% if image.is_placeholder_image %}
              {% else %}
              <span hidden data-ph-real-photo="{{ image.url }}/1600x1600"></span>
              {% endif %}
            {% endfor %}
          </div>
          <div class="ph-card-body">
            <h3 class="ph-h3">{{ sub.name }}</h3>
            <span class="ph-more">View plants</span>
          </div>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    <div class="ph-catalog-main">
      <div class="ph-product-grid" data-ph-product-grid data-sort-by-products-target>
        {% for product in category.products %}
        {% include "store-product-list" %}
        {% endfor %}
      </div>
      {% include '_store-pagination' %}
      {% if no_products_message %}
      <p class="ph-lead">{{ no_products_message }}</p>
      <p><a class="ph-btn" href="/all-collections">All collections</a></p>
      {% endif %}
      <p class="ph-copy" style="margin-top:32px;"><a class="ph-text-link" href="/all-collections">All collections <span aria-hidden="true">→</span></a></p>
    </div>
  </div>
</section>
{% endblock %}
